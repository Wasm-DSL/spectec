+/-! Hand-written helper lemmas for the `*_is_wf` proofs below (bundle19; not generated). -/
+
+theorem iswf_Forall_Map₂ {α β γ : Type} {P : γ → Prop} (f : α → β → γ) :
+    ∀ (l1 : List α) (l2 : List β), Forall₂ (fun a b => P (f a b)) l1 l2 → Forall P (Map₂ f l1 l2) := by
+  intro l1
+  induction l1 with
+  | nil => intro l2 _; simp only [Map₂, List.ap, List.map_nil, List.zipWith_nil_left]; exact iswf_Forall_nil _
+  | cons a t ih =>
+    intro l2 h
+    cases l2 with
+    | nil => simp only [Map₂, List.ap, List.map_cons, List.zipWith_nil_right]; exact iswf_Forall_nil _
+    | cons b u =>
+      have hab : P (f a b) := h (a, b) (by simp)
+      have hrest : Forall₂ (fun a b => P (f a b)) t u := fun p hp => h p (by simp [hp])
+      have := ih u hrest
+      simp only [Map₂, List.ap, List.map_cons, List.zipWith_cons_cons] at this ⊢
+      exact iswf_Forall_cons hab this
+
+theorem iswf_setproduct2 {X : Type} {P : X → Prop} (w : X) (hw : P w) :
+    ∀ (lls : List (List X)), Forall (fun l => Forall P l) lls → Forall (fun l => Forall P l) (setproduct2_ X w lls) := by
+  intro lls
+  induction lls with
+  | nil => intro _; simp only [setproduct2_]; exact iswf_Forall_nil _
+  | cons l lls ih =>
+    intro h
+    simp only [setproduct2_]
+    exact iswf_Forall_append (iswf_Forall_cons (iswf_Forall_append (iswf_Forall_cons hw (iswf_Forall_nil _)) (h l (by simp)))
+      (iswf_Forall_nil _)) (ih (fun x hx => h x (by simp [hx])))
+
+theorem iswf_setproduct1 {X : Type} {P : X → Prop} :
+    ∀ (l : List X) (lls : List (List X)), Forall P l → Forall (fun l => Forall P l) lls →
+      Forall (fun l => Forall P l) (setproduct1_ X l lls) := by
+  intro l
+  induction l with
+  | nil => intro _ _ _; simp only [setproduct1_]; exact iswf_Forall_nil _
+  | cons w l ih =>
+    intro lls hl hlls
+    simp only [setproduct1_]
+    exact iswf_Forall_append (iswf_setproduct2 w (hl w (by simp)) lls hlls) (ih lls (fun x hx => hl x (by simp [hx])) hlls)
+
+theorem iswf_setproduct {X : Type} {P : X → Prop} :
+    ∀ (lls : List (List X)), Forall (fun l => Forall P l) lls → Forall (fun l => Forall P l) (setproduct_ X lls) := by
+  intro lls
+  induction lls with
+  | nil => intro _; simp only [setproduct_]; exact iswf_Forall_cons (iswf_Forall_nil _) (iswf_Forall_nil _)
+  | cons l lls ih =>
+    intro h
+    simp only [setproduct_]
+    exact iswf_setproduct1 l _ (h l (by simp)) (ih (fun x hx => h x (by simp [hx])))
+
