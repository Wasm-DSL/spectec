                (VarE "rt")
              )
            )
          )
          (expfield
            (Atom REFS)
            (IterE
              (CaseE (Seq (Atom REF_NULL) Arg) (TupE (VarE "rt")))
              (ListN (ProjE (CallE "proj_uN_0" (ExpA (VarE "i"))) 0))
            )
