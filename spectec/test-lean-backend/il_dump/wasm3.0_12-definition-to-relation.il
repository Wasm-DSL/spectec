syntax resulttype = list(syntax valtype)

;; ../specification/wasm-3.0/1.2-syntax.types.spectec:112.1-112.61
syntax fieldtype = 
  | `%%`(`mut?` : mut?, storagetype : storagetype)

;; ../specification/wasm-3.0/1.2-syntax.types.spectec:114.1-117.34
syntax comptype = 
