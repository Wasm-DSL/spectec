    (TupT
      (typbind "_" (VarT "fieldval"))
      (typbind "_" (VarT "store"))
      (typbind "_" (VarT "fieldval"))
    )
    (RuleD
      "trans"
      (ExpP "fv_1" (VarT "fieldval"))
      (ExpP "s" (VarT "store"))
      (ExpP "fv_2" (VarT "fieldval"))
      (ExpP "fv'" (VarT "fieldval"))
      (Infix Arg >>_ (Seq Arg Arg))
      (TupE (VarE "fv_1") (VarE "s") (VarE "fv_2"))
      (RulePr
        "ImmutReachable"
        (Infix Arg >>_ (Seq Arg Arg))
        (TupE (VarE "fv_1") (VarE "s") (VarE "fv'"))
      )
      (RulePr
        "ImmutReachable"
        (Infix Arg >>_ (Seq Arg Arg))
