(RelD
  "Exninst_ok"
  (Infix Arg |- (Infix Arg : (Atom OK)))
  (TupT (typbind "_" (VarT "store")) (typbind "_" (VarT "exninst")))
  (RuleD
    "mk_Exninst_ok"
    (ExpP "s" (VarT "store"))
    (ExpP "ta" (VarT "tagaddr"))
    (ExpP "val_lst" (IterT (VarT "val") List))
    (ExpP "dt" (VarT "deftype"))
    (ExpP "t_lst" (IterT (VarT "valtype") List))
    (Infix Arg |- (Infix Arg : (Atom OK)))
    (TupE
      (VarE "s")
      (StrE
        (expfield (Atom TAG) (VarE "ta"))
        (expfield (Atom FIELDS) (VarE "val_lst"))
      )
    )
    (IfPr (CmpE LtOp nat (VarE "ta") (LenE (DotE (VarE "s") (Atom TAGS)))))
    (IfPr
      (CmpE
        EqOp
        bool
        (CallE "typeuse_deftype" (ExpA (VarE "dt")))
        (DotE (IdxE (DotE (VarE "s") (Atom TAGS)) (VarE "ta")) (Atom TYPE))
      )
    )
    (RulePr
      "Expand"
      (Infix Arg ~~ Arg)
      (TupE
        (VarE "dt")
        (CaseE
          (Infix (Seq (Atom FUNC) Arg) -> Arg)
          (TupE
            (CaseE (Seq (Atom mk_list) Arg) (TupE (VarE "t_lst")))
            (CaseE (Seq (Atom mk_list) Arg) (TupE (ListE)))
          )
        )
      )
    )
    (IfPr (CmpE EqOp bool (LenE (VarE "t_lst")) (LenE (VarE "val_lst"))))
    (IterPr
      (RulePr
        "Val_ok"
        (Infix Arg |- (Infix Arg : Arg))
        (TupE (VarE "s") (VarE "v_val") (VarE "t"))
      )
      List
      (iterexp "t" (VarE "t_lst"))
      (iterexp "v_val" (VarE "val_lst"))
    )
    (RulePr "wf_store" (Seq Arg) (TupE (VarE "s")))
    (RulePr
      "wf_exninst"
      (Seq Arg)
      (TupE
        (StrE
          (expfield (Atom TAG) (VarE "ta"))
          (expfield (Atom FIELDS) (VarE "val_lst"))
        )
      )
    )
    (RulePr
      "wf_comptype"
      (Seq Arg)
      (TupE
        (CaseE
          (Infix (Seq (Atom FUNC) Arg) -> Arg)
          (TupE
            (CaseE (Seq (Atom mk_list) Arg) (TupE (VarE "t_lst")))
            (CaseE (Seq (Atom mk_list) Arg) (TupE (ListE)))
          )
        )
      )
    )
  )
)
(RecD
  (RelD
    "ImmutReachable"
