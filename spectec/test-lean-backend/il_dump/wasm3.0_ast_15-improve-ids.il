(RelD
  "Structinst_ok"
  (Infix Arg |- (Infix Arg : (Atom OK)))
  (TupT (typbind "_" (VarT "store")) (typbind "_" (VarT "structinst")))
  (RuleD
    "mk_Structinst_ok"
    (ExpP "s" (VarT "store"))
    (ExpP "dt" (VarT "deftype"))
    (ExpP "fv_lst" (IterT (VarT "fieldval") List))
    (ExpP "mut_opt_lst" (IterT (IterT (VarT "mut") Opt) List))
    (ExpP "zt_lst" (IterT (VarT "storagetype") List))
    (Infix Arg |- (Infix Arg : (Atom OK)))
    (TupE
      (VarE "s")
      (StrE
        (expfield (Atom TYPE) (VarE "dt"))
        (expfield (Atom FIELDS) (VarE "fv_lst"))
      )
    )
    (RulePr
      "Expand"
      (Infix Arg ~~ Arg)
      (TupE
        (VarE "dt")
        (CaseE
          (Seq (Atom STRUCT) Arg)
          (TupE
            (CaseE
              (Seq (Atom mk_list) Arg)
              (TupE
                (IterE
                  (CaseE
                    (Seq (Atom mk_fieldtype) Arg Arg)
                    (TupE (VarE "mut_opt") (VarE "zt"))
                  )
                  List
                  (iterexp "mut_opt" (VarE "mut_opt_lst"))
                  (iterexp "zt" (VarE "zt_lst"))
                )
              )
            )
          )
        )
      )
    )
    (IfPr (CmpE EqOp bool (LenE (VarE "fv_lst")) (LenE (VarE "zt_lst"))))
    (IterPr
      (RulePr
        "Fieldval_ok"
        (Infix Arg |- (Infix Arg : Arg))
        (TupE (VarE "s") (VarE "fv") (VarE "zt"))
      )
      List
      (iterexp "fv" (VarE "fv_lst"))
      (iterexp "zt" (VarE "zt_lst"))
    )
    (RulePr "wf_store" (Seq Arg) (TupE (VarE "s")))
    (RulePr
      "wf_structinst"
      (Seq Arg)
      (TupE
        (StrE
          (expfield (Atom TYPE) (VarE "dt"))
          (expfield (Atom FIELDS) (VarE "fv_lst"))
        )
      )
    )
    (RulePr
      "wf_comptype"
      (Seq Arg)
      (TupE
        (CaseE
          (Seq (Atom STRUCT) Arg)
          (TupE
            (CaseE
              (Seq (Atom mk_list) Arg)
              (TupE
                (IterE
                  (CaseE
                    (Seq (Atom mk_fieldtype) Arg Arg)
                    (TupE (VarE "mut_opt") (VarE "zt"))
                  )
                  List
                  (iterexp "mut_opt" (VarE "mut_opt_lst"))
                  (iterexp "zt" (VarE "zt_lst"))
                )
              )
            )
          )
        )
      )
    )
  )
)
