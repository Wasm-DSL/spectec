    -- Instrs_ok: `%|-%:%`(C, instr_1_lst, mk_functype_functype(mk_list_resulttype(t_1_lst), mk_list_resulttype(t_2_lst)))
    -- Instrs_ok: `%|-%:%`(C, instr_2_lst, mk_functype_functype(mk_list_resulttype(t_2_lst), mk_list_resulttype(t_3_lst)))
    -- wf_context: `%`(C)
    -- (wf_instr: `%`(instr_1))*{instr_1 <- instr_1_lst}
    -- (wf_instr: `%`(instr_2))*{instr_2 <- instr_2_lst}

  ;; ../specification/wasm-2.0/6-typing.spectec:167.1-172.38
