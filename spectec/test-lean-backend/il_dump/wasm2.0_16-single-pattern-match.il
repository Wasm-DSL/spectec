    -- Instr_ok: `%|-%:%`(C, v_instr, mk_functype_functype(mk_list_resulttype(t_1_lst), mk_list_resulttype(t_2_lst)))
    -- wf_context: `%`(C)
    -- wf_instr: `%`(v_instr)

  ;; ../specification/wasm-2.0/6-typing.spectec:162.1-165.45
  rule seq{C : context, instr_1_lst : instr*, instr_2_lst : instr*, t_1_lst : valtype*, t_3_lst : valtype*, t_2_lst : valtype*}:
