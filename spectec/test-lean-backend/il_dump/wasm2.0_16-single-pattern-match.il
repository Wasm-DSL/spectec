;; ../specification/wasm-2.0/1-syntax.spectec:552.1-553.22
syntax instr = 
  | NOP
  | UNREACHABLE
  | DROP
  | SELECT(valtype_lst_opt : valtype*?)
  | BLOCK(v_blocktype : blocktype, instr_lst : instr*)
  | LOOP(v_blocktype : blocktype, instr_lst : instr*)
