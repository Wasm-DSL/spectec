    `%`(_RESULT_blocktype(valtype_opt))

  ;; ../specification/wasm-2.0/1-syntax.spectec:435.8-435.17
  rule blocktype_case_1{v_typeidx : typeidx}:
    `%`(_IDX_blocktype(v_typeidx))
    -- wf_uN: `%%`(32, v_typeidx)

