def $inst_valtype(moduleinst : moduleinst, valtype : valtype) : valtype
  ;; test.spectec:4587.1-4587.75
  def $inst_valtype{moduleinst : moduleinst, t : valtype}(moduleinst, t) = $subst_all_valtype(t, $typeuse_deftype(iter_val#13)*{iter_val#13 <- moduleinst.TYPES_moduleinst})

