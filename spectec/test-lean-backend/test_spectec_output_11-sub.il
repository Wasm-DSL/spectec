  def $free_reftype{`null?` : null?, heaptype : heaptype}(REF_reftype(null#2?{null#2 <- `null?`}, heaptype)) = $free_heaptype(heaptype)

;; test.spectec:820.1-820.34
def $free_typeuse(typeuse : typeuse) : free
