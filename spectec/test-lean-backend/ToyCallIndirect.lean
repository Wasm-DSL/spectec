-- PART 3 – OLD BACKEND
-- Source: spectec/src/temp_zy_dev/wasm2.0.lean
-- Lines 6526–6540.
-- MODIFIED for Lean 4 and shared types. Every change marked ★.
-- ═══════════════════════════════════════════════════════

namespace OldBackend

/-
  The old backend encodes the same spec rule differently.

  call_indirect_trap (OLD) requires:
    (1) i IS in bounds: proj_uN_0 i < List.length REFS   ← KEY DIFFERENCE
    (2) i is an integer value
    (3) caller provides a specific a with a < |funcinst|  ← KEY DIFFERENCE
    (4) REFS[i] ≠ REF_FUNC_ADDR a  OR  type mismatch
    (5) wf_num_ I32 i

  Contrast with new backend (call_indirect_trap):
    Only premise: ¬ Step_read_before_call_indirect_trap (the config)

  GAPS in the old encoding:
    GAP 1 (out-of-bounds trap): When REFS = [] or i ≥ |REFS|, premise (1) fails.
      The config is STUCK: neither call nor trap rule applies.
      The Wasm spec says this should trap. The old backend cannot prove it.

    GAP 2 (witness burden): Premise (3) requires the caller to provide a
      SPECIFIC a that is in-bounds for funcinst. This means:
      (a) If there are no functions in the store, (3) is unprovable.
      (b) In proofs, you must "invent" an a, but the choice of a may be
          arbitrary and not connected to what REFS[i] actually contains.
      The new backend resolves both by using ¬ Step_read_before_...,
      which lets Lean provide a hypothetical a via cases and you refute it.
-/

inductive Step_read : config → List admininstr → Prop where
  -- call_indirect_call: all conditions hold → call the function
  -- ★ Modified: Lean 3 "forall (z : state) ... ->" → Lean 4 named args
  -- ★ Modified: ".CONST .I32" → "admininstr.CONST numtype.I32" (explicit namespace)
  -- ★ Modified: ".CALL_INDIRECT x y" → "admininstr.CALL_INDIRECT x y"
  -- ★ Modified: ".CALL_ADDR a" → "admininstr.CALL_ADDR a"
  -- ★ Modified: wf_num_ added after other premises (was 1st in original; order is logically equivalent)
  | call_indirect_call (z : state) (i : num_) (x : idx) (y : idx) (a : addr) :
      (proj_uN_0 (Option.get! (proj_num__0 i))) < (List.length ((fun_table z x).REFS)) →
      (proj_num__0 i) != none →
      (((fun_table z x).REFS)[proj_uN_0 (Option.get! (proj_num__0 i))]!) == (ref.REF_FUNC_ADDR a) →
      (a < (List.length (fun_funcinst z))) →
      ((fun_type z y) == (((fun_funcinst z)[a]!).TYPE)) →
      wf_num_ numtype.I32 i →  -- ★ wf_num_ is opaque (axiomatized above)
      Step_read (config.mk_config z [admininstr.CONST numtype.I32 i, admininstr.CALL_INDIRECT x y])
                [admininstr.CALL_ADDR a]

  -- call_indirect_trap: in-bounds BUT mismatch → TRAP
  -- ★ Same syntax modifications as call above.
  -- ★ CRITICAL: premise (1) below requires i to be IN BOUNDS.
  --   This makes the rule INAPPLICABLE when i ≥ |REFS|, including when REFS = [].
  | call_indirect_trap (z : state) (i : num_) (x : idx) (y : idx) (a : addr) :
      -- (1) ← THE PROBLEMATIC PREMISE: i must be in bounds for REFS.
      --   Consequence: out-of-bounds index cannot trigger this trap rule.
      (proj_uN_0 (Option.get! (proj_num__0 i))) < (List.length ((fun_table z x).REFS)) →
      -- (2) i must be an integer value (not a float)
      (proj_num__0 i) != none →
      -- (3) ← REQUIRES CALLER-SUPPLIED 'a': a must be a valid funcinst address.
      --   The trap fires NOT because a is wrong, but because REFS[i] doesn't
      --   match a OR the type doesn't match. But a still has to be "valid".
      (a < (List.length (fun_funcinst z))) →
      -- (4) The failure: either the table entry isn't a function ref to a,
      --   or it IS but the type is wrong.
      -- ★ Note: || here is BEq-level boolean OR (not propositional ∨).
      --   In the original old backend: the same || was used.
      (   (((fun_table z x).REFS)[proj_uN_0 (Option.get! (proj_num__0 i))]! != (ref.REF_FUNC_ADDR a))
       || ((fun_type z y) != (((fun_funcinst z)[a]!).TYPE))   ) →
      -- (5) i is a well-formed i32 value
      wf_num_ numtype.I32 i →
      Step_read (config.mk_config z [admininstr.CONST numtype.I32 i, admininstr.CALL_INDIRECT x y])
                [admininstr.TRAP]

-- ───────────────────────────────────────────────────────
-- THEOREM ATTEMPT 1 (Old): Empty table → TRAP
-- ───────────────────────────────────────────────────────

/-- ATTEMPT: If the table is empty, call_indirect traps.

    This theorem CANNOT be proved with the old backend's rules.

    To apply call_indirect_trap, we need premise (1):
      proj_uN_0 (...) < List.length (fun_table z x).REFS
    With hempty: REFS = [], this becomes:
      proj_uN_0 (...) < List.length []
      = proj_uN_0 (...) < 0
    This is FALSE for any Nat. No applicable rule exists.

    THE CONFIG IS STUCK. The old backend cannot derive [TRAP] for an
    empty table, even though the Wasm spec clearly requires a trap.

    This is GAP 1 of the old backend.
    We mark it sorry to document the genuine incompleteness. -/
theorem empty_table_stuck_old
    (z : state) (i : num_) (x y : idx)
    (hempty : (fun_table z x).REFS = []) :
    Step_read (config.mk_config z [admininstr.CONST numtype.I32 i, admininstr.CALL_INDIRECT x y])
              [admininstr.TRAP] := by
  apply Step_read.call_indirect_trap
  simp only [hempty, List.length_nil]
  

  -- To proceed, we would need to apply call_indirect_trap.
  -- That requires supplying a specific address 'a' and proving premise (1).
  -- Premise (1): proj_uN_0 (...) < List.length []  =  n < 0
  -- This is False for Nat. There is no valid proof.
  --
  -- Neither call_indirect_call nor call_indirect_trap can fire here.
  -- The old backend has no rule for out-of-bounds trap.
  sorry  -- ← GENUINE GAP: the old encoding is incomplete for this case

-- ───────────────────────────────────────────────────────
-- THEOREM ATTEMPT 2 (Old): Progress
-- ───────────────────────────────────────────────────────

/-- ATTEMPT: Progress for call_indirect under the old backend.

    Also CANNOT be proved. The stuck-state example above (empty table)
    is a concrete witness against progress: for REFS = [], neither
    [CALL_ADDR a] nor [TRAP] is derivable.

    The new backend avoids this by having call_indirect_trap require
    only ¬ Step_read_before_call_indirect_trap, which is trivially
    satisfied when REFS = [] (since h1 fails). -/
theorem call_indirect_progress_old
    (z : state) (i : num_) (x y : idx) :
    (∃ a : addr,
       Step_read (config.mk_config z [admininstr.CONST numtype.I32 i, admininstr.CALL_INDIRECT x y])
                 [admininstr.CALL_ADDR a])
    ∨
    Step_read (config.mk_config z [admininstr.CONST numtype.I32 i, admininstr.CALL_INDIRECT x y])
              [admininstr.TRAP] := by
  -- We would need to split on whether REFS is empty or not,
  -- and whether i is in bounds. But the old backend has no trap rule
  -- for the out-of-bounds case, so the right disjunct is unprovable
  -- without extra hypotheses.
  sorry  -- ← Old backend cannot prove this in general

-- ───────────────────────────────────────────────────────
-- THEOREM 3 (Old): What the old backend CAN prove
-- ───────────────────────────────────────────────────────

/-- The old backend CAN prove trap when the caller explicitly supplies:
      - a specific address 'a'
      - proof that i IS in bounds
      - proof that a IS a valid function index
      - proof of a mismatch (bad ref or type mismatch)
      - proof that i is a well-formed i32

    Compare to the new backend:
      Call `Step_read.call_indirect_trap z i x y h` where h : ¬ success predicate.
      No a required. No in-bounds condition required. Just refute the success predicate.

    This shows the old backend has HIGHER PROOF BURDEN: the caller must
    provide more evidence even for a straightforward trap. -/
theorem explicit_mismatch_traps_old
    (z : state) (i : num_) (x y : idx) (a : addr)
    -- All of these must be supplied by the CALLER:
    (h_in_bounds : (proj_uN_0 (Option.get! (proj_num__0 i))) < (List.length ((fun_table z x).REFS)))
    (h_is_int    : (proj_num__0 i) != none)
    (h_a_valid   : a < (List.length (fun_funcinst z)))
    (h_mismatch  :
         (((fun_table z x).REFS)[proj_uN_0 (Option.get! (proj_num__0 i))]! != (ref.REF_FUNC_ADDR a))
      || ((fun_type z y) != (((fun_funcinst z)[a]!).TYPE)))
    (h_wf        : wf_num_ numtype.I32 i) :
    Step_read (config.mk_config z [admininstr.CONST numtype.I32 i, admininstr.CALL_INDIRECT x y])
              [admininstr.TRAP] :=
  -- Apply the constructor directly.
  Step_read.call_indirect_trap z i x y a h_in_bounds h_is_int h_a_valid h_mismatch h_wf

end OldBackend


