;; ../specification/wasm-1.0/6-typing.spectec:396.1-396.80
relation Import_ok: `%|-%:%`(context, import, externtype)
  ;; ../specification/wasm-1.0/6-typing.spectec:400.1-402.31
  rule _{C : context, name_1 : name, name_2 : name, xt : externtype}:
