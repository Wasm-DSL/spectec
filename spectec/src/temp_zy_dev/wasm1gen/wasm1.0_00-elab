;; ../specification/wasm-1.0/4-runtime.spectec:5.1-5.39
syntax addr = nat

;; ../specification/wasm-1.0/4-runtime.spectec:6.1-6.53
syntax funcaddr = addr

;; ../specification/wasm-1.0/4-runtime.spectec:7.1-7.53
syntax globaladdr = addr

;; ../specification/wasm-1.0/4-runtime.spectec:8.1-8.51
syntax tableaddr = addr

;; ../specification/wasm-1.0/4-runtime.spectec:9.1-9.50
syntax memaddr = addr

;; ../specification/wasm-1.0/4-runtime.spectec:20.1-21.70
syntax externaddr = 
  | FUNC(funcaddr : funcaddr)
  | GLOBAL(globaladdr : globaladdr)
  | TABLE(tableaddr : tableaddr)
  | MEM(memaddr : memaddr)

;; ../specification/wasm-1.0/4-runtime.spectec:32.1-33.55
syntax val = 
  | CONST(valtype : valtype, val_(valtype))

;; ../specification/wasm-1.0/4-runtime.spectec:35.1-36.22
syntax result = 
  | _VALS(`val*` : val*)
  | TRAP

;; ../specification/wasm-1.0/4-runtime.spectec:61.1-63.22
syntax exportinst = 
{
  NAME name,
  ADDR externaddr
}

;; ../specification/wasm-1.0/4-runtime.spectec:65.1-71.26
syntax moduleinst = 
{
  TYPES functype*,
  FUNCS funcaddr*,
  GLOBALS globaladdr*,
  TABLES tableaddr*,
  MEMS memaddr*,
  EXPORTS exportinst*
}

;; ../specification/wasm-1.0/4-runtime.spectec:48.1-51.16
syntax funcinst = 
{
  TYPE functype,
  MODULE moduleinst,
  CODE func
}

;; ../specification/wasm-1.0/4-runtime.spectec:52.1-54.16
syntax globalinst = 
{
  TYPE globaltype,
  VALUE val
}

;; ../specification/wasm-1.0/4-runtime.spectec:55.1-57.24
syntax tableinst = 
{
  TYPE tabletype,
  REFS funcaddr?*
}

;; ../specification/wasm-1.0/4-runtime.spectec:58.1-60.18
syntax meminst = 
{
  TYPE memtype,
  BYTES byte*
}

;; ../specification/wasm-1.0/4-runtime.spectec:83.1-87.20
syntax store = 
{
  FUNCS funcinst*,
  GLOBALS globalinst*,
  TABLES tableinst*,
  MEMS meminst*
}

;; ../specification/wasm-1.0/4-runtime.spectec:89.1-91.24
syntax frame = 
{
  LOCALS val*,
  MODULE moduleinst
}

;; ../specification/wasm-1.0/4-runtime.spectec:93.1-93.47
syntax state = 
  | `%;%`(store : store, frame : frame)

;; ../specification/wasm-1.0/4-runtime.spectec:105.1-110.9
rec {

;; ../specification/wasm-1.0/4-runtime.spectec:105.1-110.9
syntax admininstr = 
  | NOP
  | UNREACHABLE
  | DROP
  | SELECT
  | BLOCK(blocktype : blocktype, `instr*` : instr*)
  | LOOP(blocktype : blocktype, `instr*` : instr*)
  | `IF%%ELSE%`(blocktype : blocktype, `instr*` : instr*, `instr*` : instr*)
  | BR(labelidx : labelidx)
  | BR_IF(labelidx : labelidx)
  | BR_TABLE(`labelidx*` : labelidx*, labelidx : labelidx)
  | CALL(funcidx : funcidx)
  | CALL_INDIRECT(typeidx : typeidx)
  | RETURN
  | CONST(valtype : valtype, val_(valtype))
  | UNOP(valtype : valtype, unop_(valtype))
  | BINOP(valtype : valtype, binop_(valtype))
  | TESTOP(valtype : valtype, testop_(valtype))
  | RELOP(valtype : valtype, relop_(valtype))
  | CVTOP(valtype_1 : valtype, valtype_2 : valtype, cvtop : cvtop)
    -- if (valtype_1 =/= valtype_2)
  | `LOCAL.GET`(localidx : localidx)
  | `LOCAL.SET`(localidx : localidx)
  | `LOCAL.TEE`(localidx : localidx)
  | `GLOBAL.GET`(globalidx : globalidx)
  | `GLOBAL.SET`(globalidx : globalidx)
  | LOAD(valtype : valtype, loadop_(valtype)?, memarg : memarg)
  | STORE(valtype : valtype, `sz?` : sz?, memarg : memarg) {`Inn?` : Inn?, `valtype?` : valtype?}
    -- (if ((valtype = (Inn : Inn <: valtype)) /\ (sz!`%`_sz.0 < $size((Inn : Inn <: valtype)))))?{Inn <- `Inn?`, sz <- `sz?`, valtype <- `valtype?`}
  | `MEMORY.SIZE`
  | `MEMORY.GROW`
  | CALL_ADDR(funcaddr : funcaddr)
  | `LABEL_%{%}%`(n : n, `instr*` : instr*, `admininstr*` : admininstr*)
  | `FRAME_%{%}%`(n : n, frame : frame, `admininstr*` : admininstr*)
  | TRAP
}

;; ../specification/wasm-1.0/4-runtime.spectec:94.1-94.62
syntax config = 
  | `%;%`(state : state, `admininstr*` : admininstr*)

;; ../specification/wasm-1.0/5-runtime-aux.spectec:7.1-7.29
def $default_(valtype : valtype) : val
  ;; ../specification/wasm-1.0/5-runtime-aux.spectec:9.1-9.35
  def $default_(I32_valtype) = CONST_val(I32_valtype, `%`_val_(0))
  ;; ../specification/wasm-1.0/5-runtime-aux.spectec:10.1-10.35
  def $default_(I64_valtype) = CONST_val(I64_valtype, `%`_val_(0))
  ;; ../specification/wasm-1.0/5-runtime-aux.spectec:11.1-11.44
  def $default_(F32_valtype) = CONST_val(F32_valtype, $fzero(32))
  ;; ../specification/wasm-1.0/5-runtime-aux.spectec:12.1-12.44
  def $default_(F64_valtype) = CONST_val(F64_valtype, $fzero(64))

;; ../specification/wasm-1.0/5-runtime-aux.spectec:17.1-17.63
rec {

;; ../specification/wasm-1.0/5-runtime-aux.spectec:17.1-17.63
def $funcsxa(externaddr*) : funcaddr*
  ;; ../specification/wasm-1.0/5-runtime-aux.spectec:22.1-22.24
  def $funcsxa([]) = []
  ;; ../specification/wasm-1.0/5-runtime-aux.spectec:23.1-23.47
  def $funcsxa{fa : funcaddr, `xv*` : externaddr*}([FUNC_externaddr(fa)] ++ xv*{xv <- `xv*`}) = [fa] ++ $funcsxa(xv*{xv <- `xv*`})
  ;; ../specification/wasm-1.0/5-runtime-aux.spectec:24.1-24.59
  def $funcsxa{externaddr : externaddr, `xv*` : externaddr*}([externaddr] ++ xv*{xv <- `xv*`}) = $funcsxa(xv*{xv <- `xv*`})
    -- otherwise
}

