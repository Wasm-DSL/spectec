;; ../specification/wasm-1.0/6-typing.spectec:347.1-347.73
relation Data_ok: `%|-%:OK`(context, data)
  ;; ../specification/wasm-1.0/6-typing.spectec:384.1-387.42
  rule _{C : context, expr : expr, `b*` : byte*, lim : limits}:
