;; ../specification/wasm-1.0/6-typing.spectec:398.1-398.83
relation Externidx_ok: `%|-%:%`(context, externidx, externtype)
  ;; ../specification/wasm-1.0/6-typing.spectec:409.1-411.24
  rule func{C : context, x : idx, ft : functype}:
