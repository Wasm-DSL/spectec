/-- Lean-only. `fun_elem` at an index typed by the frame's module context. -/
theorem fun_elem_typed (s : store) (f : frame) (C : context) (x : uN)
    (h : Moduleinst_ok s f.MODULE C) (hx : proj_uN_0 x < C.ELEMS.length) :
    fun_elem (state.mk_state s f) x (s.ELEMS[f.MODULE.ELEMS[proj_uN_0 x]!]!) :=
  fun_elem.fun_elem_case_0 s f x (Moduleinst_ok_elem_addr s f.MODULE C _ h hx).2
    (Moduleinst_ok_elem_addr s f.MODULE C _ h hx).1

/-- Lean-only. `fun_type` at an index typed by the frame's module context. -/
theorem fun_type_typed (s : store) (f : frame) (C : context) (x : uN)
    (h : Moduleinst_ok s f.MODULE C) (hx : proj_uN_0 x < C.TYPES.length) :
    fun_type (state.mk_state s f) x (f.MODULE.TYPES[proj_uN_0 x]!) := by
  refine fun_type.fun_type_case_0 s f x ?_
  exact minst_invert_functypes s f.MODULE C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ ▸ hx

