/-! ### Lean-only: index bounds for the state lookups

With `sideconditions_on_defs`, the state lookups `fun_global`, `fun_table`, `fun_mem`, `fun_elem`,
`fun_data`, `fun_func` and `fun_type` are relations whose premises bound the index into the module
instance and the address into the store. Progress has to supply those premises. `Moduleinst_ok`
provides both: the instance's address lists have the context's lengths (`Moduleinst_ok_lengths`),
and every address in them is in bounds for the store (`minst_invert_*`). The `*_addr` lemmas
combine the two, and the `fun_*_typed` lemmas build the lookup from a typed index. -/

/-- Lean-only. The `i`-th global address of a typed module instance exists and is in bounds. -/
theorem Moduleinst_ok_global_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
    (h : Moduleinst_ok s minst C) (hi : i < C.GLOBALS.length) :
    i < minst.GLOBALS.length ∧ minst.GLOBALS[i]! < s.GLOBALS.length := by
  have hi' : i < minst.GLOBALS.length := (Moduleinst_ok_lengths s minst C h).1 ▸ hi
  obtain ⟨_, _, hb, _⟩ := minst_invert_globals s minst C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ _
    (mem_zip_getElem! _ _ i hi' hi)
  exact ⟨hi', hb⟩

/-- Lean-only. The `i`-th function address of a typed module instance exists and is in bounds. -/
theorem Moduleinst_ok_func_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
    (h : Moduleinst_ok s minst C) (hi : i < C.FUNCS.length) :
    i < minst.FUNCS.length ∧ minst.FUNCS[i]! < s.FUNCS.length := by
  have hi' : i < minst.FUNCS.length := (Moduleinst_ok_lengths s minst C h).2.1 ▸ hi
  obtain ⟨_, _, _, hb, _⟩ := minst_invert_funcs s minst C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ _
    (mem_zip_getElem! _ _ i hi' hi)
  exact ⟨hi', hb⟩

/-- Lean-only. The `i`-th memory address of a typed module instance exists and is in bounds. -/
theorem Moduleinst_ok_mem_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
    (h : Moduleinst_ok s minst C) (hi : i < C.MEMS.length) :
    i < minst.MEMS.length ∧ minst.MEMS[i]! < s.MEMS.length := by
  have hi' : i < minst.MEMS.length := (Moduleinst_ok_lengths s minst C h).2.2.1 ▸ hi
  obtain ⟨_, _, hb, _⟩ := minst_invert_mems s minst C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ _
    (mem_zip_getElem! _ _ i hi' hi)
  exact ⟨hi', hb⟩

/-- Lean-only. The `i`-th table address of a typed module instance exists and is in bounds. -/
theorem Moduleinst_ok_table_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
    (h : Moduleinst_ok s minst C) (hi : i < C.TABLES.length) :
    i < minst.TABLES.length ∧ minst.TABLES[i]! < s.TABLES.length := by
  have hi' : i < minst.TABLES.length := (Moduleinst_ok_lengths s minst C h).2.2.2.1 ▸ hi
  obtain ⟨_, _, hb, _⟩ := minst_invert_tables s minst C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ _
    (mem_zip_getElem! _ _ i hi' hi)
  exact ⟨hi', hb⟩

/-- Lean-only. The `i`-th data address of a typed module instance exists and is in bounds. -/
theorem Moduleinst_ok_data_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
    (h : Moduleinst_ok s minst C) (hi : i < C.DATAS.length) :
    i < minst.DATAS.length ∧ minst.DATAS[i]! < s.DATAS.length := by
  have hi' : i < minst.DATAS.length := (Moduleinst_ok_lengths s minst C h).2.2.2.2.1 ▸ hi
  refine ⟨hi', ?_⟩
  cases h with
  | mk_Moduleinst_ok _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hdb =>
    exact hdb _ (by rw [getElem!_pos _ i hi']; exact List.getElem_mem hi')

/-- Lean-only. The `i`-th element-segment address of a typed module instance exists and is in
    bounds. -/
theorem Moduleinst_ok_elem_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
    (h : Moduleinst_ok s minst C) (hi : i < C.ELEMS.length) :
    i < minst.ELEMS.length ∧ minst.ELEMS[i]! < s.ELEMS.length := by
  have hi' : i < minst.ELEMS.length := (Moduleinst_ok_lengths s minst C h).2.2.2.2.2 ▸ hi
  obtain ⟨_, hb, _⟩ := minst_invert_elems s minst C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ _
    (mem_zip_getElem! _ _ i hi' hi)
  exact ⟨hi', hb⟩

/-- Lean-only. `fun_global` at an index typed by the frame's module context. -/
theorem fun_global_typed (s : store) (f : frame) (C : context) (x : uN)
    (h : Moduleinst_ok s f.MODULE C) (hx : proj_uN_0 x < C.GLOBALS.length) :
    fun_global (state.mk_state s f) x (s.GLOBALS[f.MODULE.GLOBALS[proj_uN_0 x]!]!) :=
  fun_global.fun_global_case_0 s f x (Moduleinst_ok_global_addr s f.MODULE C _ h hx).2
    (Moduleinst_ok_global_addr s f.MODULE C _ h hx).1

/-- Lean-only. `fun_func` at an index typed by the frame's module context. -/
theorem fun_func_typed (s : store) (f : frame) (C : context) (x : uN)
    (h : Moduleinst_ok s f.MODULE C) (hx : proj_uN_0 x < C.FUNCS.length) :
    fun_func (state.mk_state s f) x (s.FUNCS[f.MODULE.FUNCS[proj_uN_0 x]!]!) :=
  fun_func.fun_func_case_0 s f x (Moduleinst_ok_func_addr s f.MODULE C _ h hx).2
    (Moduleinst_ok_func_addr s f.MODULE C _ h hx).1

