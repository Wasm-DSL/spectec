    (Moduleinst_ok_table_addr s f.MODULE C _ h hx).1

/-- Lean-only. `fun_data` at an index typed by the frame's module context. -/
theorem fun_data_typed (s : store) (f : frame) (C : context) (x : uN)
    (h : Moduleinst_ok s f.MODULE C) (hx : proj_uN_0 x < C.DATAS.length) :
    fun_data (state.mk_state s f) x (s.DATAS[f.MODULE.DATAS[proj_uN_0 x]!]!) :=
  fun_data.fun_data_case_0 s f x (Moduleinst_ok_data_addr s f.MODULE C _ h hx).2
