    fun_mem (state.mk_state s f) x (s.MEMS[f.MODULE.MEMS[proj_uN_0 x]!]!) :=
  fun_mem.fun_mem_case_0 s f x (Moduleinst_ok_mem_addr s f.MODULE C _ h hx).2
