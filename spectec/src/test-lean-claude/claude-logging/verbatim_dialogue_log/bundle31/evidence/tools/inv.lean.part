    fun_elem (state.mk_state s f) x ei →
    proj_uN_0 x < f.MODULE.ELEMS.length ∧ f.MODULE.ELEMS[proj_uN_0 x]! < s.ELEMS.length ∧
      ei = s.ELEMS[f.MODULE.ELEMS[proj_uN_0 x]!]! := by
