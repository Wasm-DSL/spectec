theorem fun_local_inv {s : store} {f : frame} {x : uN} {v : val} :
    fun_local (state.mk_state s f) x v →
    proj_uN_0 x < f.LOCALS.length ∧ v = f.LOCALS[proj_uN_0 x]! := by
  rintro ⟨⟩; exact ⟨‹_›, rfl⟩

