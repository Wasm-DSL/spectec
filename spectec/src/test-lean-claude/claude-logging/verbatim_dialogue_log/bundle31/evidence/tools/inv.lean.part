    fun_table (state.mk_state s f) x ti →
    proj_uN_0 x < f.MODULE.TABLES.length ∧ f.MODULE.TABLES[proj_uN_0 x]! < s.TABLES.length ∧
      ti = s.TABLES[f.MODULE.TABLES[proj_uN_0 x]!]! := by
