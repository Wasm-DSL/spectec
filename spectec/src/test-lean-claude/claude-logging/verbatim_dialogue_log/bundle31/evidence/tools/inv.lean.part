theorem fun_data_inv {s : store} {f : frame} {x : uN} {di : datainst} :
    fun_data (state.mk_state s f) x di →
    proj_uN_0 x < f.MODULE.DATAS.length ∧ f.MODULE.DATAS[proj_uN_0 x]! < s.DATAS.length ∧
      di = s.DATAS[f.MODULE.DATAS[proj_uN_0 x]!]! := by
