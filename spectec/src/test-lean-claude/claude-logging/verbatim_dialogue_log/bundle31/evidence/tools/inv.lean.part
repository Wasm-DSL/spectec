/-! ### Inversion of the state lookups (Lean-only)

The lookups `fun_type`, `fun_func`, `fun_global`, `fun_table`, `fun_mem`, `fun_elem`, `fun_data`
and `fun_local` are relations with one constructor each. These lemmas read off its premises (the
index bounds) and its output, for a lookup whose output is a term rather than a variable (`cases`
cannot unify such an output with the constructor's indexing expression). -/

theorem fun_type_inv {s : store} {f : frame} {x : uN} {ft : functype} :
    fun_type (state.mk_state s f) x ft →
    proj_uN_0 x < f.MODULE.TYPES.length ∧ ft = f.MODULE.TYPES[proj_uN_0 x]! := by
  rintro ⟨⟩; exact ⟨‹_›, rfl⟩

theorem fun_func_inv {s : store} {f : frame} {x : uN} {fi : funcinst} :
    fun_func (state.mk_state s f) x fi →
    proj_uN_0 x < f.MODULE.FUNCS.length ∧ f.MODULE.FUNCS[proj_uN_0 x]! < s.FUNCS.length ∧
      fi = s.FUNCS[f.MODULE.FUNCS[proj_uN_0 x]!]! := by
  rintro ⟨⟩; exact ⟨‹_›, ‹_›, rfl⟩

theorem fun_global_inv {s : store} {f : frame} {x : uN} {gi : globalinst} :
    fun_global (state.mk_state s f) x gi →
    proj_uN_0 x < f.MODULE.GLOBALS.length ∧ f.MODULE.GLOBALS[proj_uN_0 x]! < s.GLOBALS.length ∧
      gi = s.GLOBALS[f.MODULE.GLOBALS[proj_uN_0 x]!]! := by
  rintro ⟨⟩; exact ⟨‹_›, ‹_›, rfl⟩

