+/-! ### Lean-only: index bounds for the state lookups
+
+With `sideconditions_on_defs`, the state lookups `fun_global`, `fun_table`, `fun_mem`, `fun_elem`,
+`fun_data` and `fun_type` are relations whose premises bound the index into the module instance
+and (except for `fun_type`) the address into the store; the updates `fun_with_*` need the first
+bound too. Progress has to supply those premises. `Moduleinst_ok` provides both: the instance's
+address lists have the context's lengths (`Moduleinst_ok_lengths`), and every address in them is
+in bounds for the store (`minst_invert_*`). The `*_addr` lemmas combine the two, and the
+`fun_*_typed` lemmas build the lookup from a typed index. -/
+
+/-- Lean-only. The `i`-th global address of a typed module instance exists and is in bounds. -/
+theorem Moduleinst_ok_global_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
+    (h : Moduleinst_ok s minst C) (hi : i < C.GLOBALS.length) :
+    i < minst.GLOBALS.length ∧ minst.GLOBALS[i]! < s.GLOBALS.length := by
+  have hi' : i < minst.GLOBALS.length := (Moduleinst_ok_lengths s minst C h).1 ▸ hi
+  obtain ⟨_, _, hb, _⟩ := minst_invert_globals s minst C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ _
+    (mem_zip_getElem! _ _ i hi' hi)
+  exact ⟨hi', hb⟩
+
+/-- Lean-only. The `i`-th memory address of a typed module instance exists and is in bounds. -/
+theorem Moduleinst_ok_mem_addr (s : store) (minst : moduleinst) (C : context) (i : Nat)
+    (h : Moduleinst_ok s minst C) (hi : i < C.MEMS.length) :
+    i < minst.MEMS.length ∧ minst.MEMS[i]! < s.MEMS.length := by
+  have hi' : i < minst.MEMS.length := (Moduleinst_ok_lengths s minst C h).2.2.1 ▸ hi
+  obtain ⟨_, _, hb, _⟩ := minst_invert_mems s minst C C h ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ _
+    (mem_zip_getElem! _ _ i hi' hi)
+  exact ⟨hi', hb⟩
+
