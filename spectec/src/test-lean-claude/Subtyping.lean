  refine ⟨ts.take rin.length, rout, ts.drop rin.length, nout,
    (List.take_append_drop rin.length ts).symm, hty2,
    resulttype_sub_trans _ _ _ hrin' hrsub, resulttype_sub_trans _ _ _ hsup' hsup, hnout⟩

