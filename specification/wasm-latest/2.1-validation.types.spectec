  -- if k = $offset(read__action) 
  -- if $offset(read__action) = $offset(write__action)

rule Hbconsistent/init:
  trace reg k |- evt_R Hbconsistent evt_W
  -- if ~$happensbefore(evt_R, evt_W)
  -- --
  -- if $sync($access_r(reg, evt_W), $access_r(reg, evt_R)) ==> $happensbefore(evt_W, evt_R)
  -- --
  -- if evt_W'* = $writing_filter(trace)
  -- --
  -- (if $happensbefore(evt_W, evt_W') /\ $happensbefore(evt_W', evt_R) ==> $notinrange(k, $range($access_r(reg, evt_W'))))*

;; TODO: Find if within premise line break possible
rule Sclastvisible/init:
  trace reg |- evt_R Sclastvisible evt_W
  -- if evt_W'* = $writing_filter(trace)
  -- --
  -- (if 
      $happensbefore(evt_R, evt_W) ==>
        $tot(evt_W, evt_W') /\ $tot(evt_W', evt_R) /\ $sync($access_r(reg, evt_W), $access_r(reg, evt_R)) ==>
        ~$sync($access_r(reg, evt_W'), $access_r(reg, evt_R)) 
        /\
        $happensbefore(evt_W, evt_W') /\ $tot(evt_W', evt_R) ==>
        ~$sync($access_r(reg, evt_W'), $access_r(reg, evt_R))
        /\
        $tot(evt_W, evt_W') /\ $happensbefore(evt_W', evt_R) ==>
        ~$sync($access_r(reg, evt_W), $access_r(reg, evt_W'))
      )*

rule Notear/init:
  reg |- evt_R Notear evt_W*
  -- if evt_W'* = $same_and_tearfree_filter(reg, evt_R, evt_W*)
  -- if $tearfree($access_r(reg, evt_R)) ==> |evt_W'*| <= 1

rule Suspensionsconsistent/init:
  i reg |- tr Suspensionsconsistent
  -- if tr' = $susp_filter(reg, i, tr)
  -- Suspensionsconsistentwith: i reg |- tr' Suspensionsconsistentwith eps
  -- --
  -- if $forall2(event, event, tr', tr', $impliestothappensbefore)

rule Suspensionsconsistentwith/init:
  i reg |- eps Suspensionsconsistentwith timestamp*

rule Suspensionsconsistentwith/wait:
  i reg |- evt tr Suspensionsconsistentwith time*
  -- if $id($access_r(reg, evt)) = (WAIT (reg i) s64)
  -- --
  -- Suspensionsconsistentwith: i reg |- tr Suspensionsconsistentwith (evt.TIME time*)

rule Suspensionsconsistentwith/timeout:
  i reg |- evt tr Suspensionsconsistentwith (time1^a evt.TIMEp time2^b)
  -- if $id($access_r(reg, evt)) = (WOKEN (reg i))
  -- --
  -- Suspensionsconsistentwith: i reg |- tr Suspensionsconsistentwith (evt.TIME time2^b)

rule Suspensionsconsistentwith/notify:
  i reg |- evt_N evt^n tr Suspensionsconsistentwith (time^m (evt.TIMEp)^n)
  -- (if $id($access_r(reg, evt)) = (WOKEN (reg i)))^n
  -- -- 
  -- if $id($access_r(reg, evt_N)) = (NOTIFY location n k)
  -- if n < k ==> m = 0
  -- --
  -- Suspensionsconsistentwith: i reg |- tr Suspensionsconsistentwith time^m

