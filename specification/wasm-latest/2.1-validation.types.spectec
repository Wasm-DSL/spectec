rule Valueconsistent/init:
  trace |- evt_R Valueconsistent evt_W
  -- if read__action <- $reading_action_filter(evt_R.ACTIONS)
  -- if write__action <- $write_action_filter(evt_W.ACTIONS)
  -- --
