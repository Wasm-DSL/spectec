;;
;; Validation of Types
;;

;; Value types

relation Numtype_ok: context |- numtype : OK    hint(name "K-num")  hint(macro "%numtype")
relation Vectype_ok: context |- vectype : OK    hint(name "K-vec")  hint(macro "%vectype")
relation Heaptype_ok: context |- heaptype : OK  hint(name "K-heap") hint(macro "%heaptype")
relation Reftype_ok: context |- reftype : OK    hint(name "K-ref")  hint(macro "%reftype")
relation Valtype_ok: context |- valtype : OK    hint(name "K-val")  hint(macro "%valtype")
relation Typeuse_ok: context |- typeuse : OK    hint(name "K-typeuse") hint(macro "%typeuse")

rule Numtype_ok:
  C |- numtype : OK

rule Vectype_ok:
  C |- vectype : OK

rule Heaptype_ok/abs:
  C |- absheaptype : OK

rule Heaptype_ok/typeuse:
  C |- typeuse : OK
  -- Typeuse_ok: C |- typeuse : OK

rule Reftype_ok:
  C |- REF NULL? heaptype : OK
  -- Heaptype_ok: C |- heaptype : OK

rule Valtype_ok/num:
  C |- numtype : OK
  -- Numtype_ok: C |- numtype : OK

rule Valtype_ok/vec:
  C |- vectype : OK
  -- Vectype_ok: C |- vectype : OK

rule Valtype_ok/ref:
  C |- reftype : OK
  -- Reftype_ok: C |- reftype : OK

rule Valtype_ok/bot:
  C |- BOT : OK


;; Result & instruction types

relation Resulttype_ok: context |- resulttype : OK  hint(name "K-result") hint(macro "%resulttype")
relation Instrtype_ok: context |- instrtype : OK    hint(name "K-instr")  hint(macro "%instrtype")

rule Resulttype_ok:
  C |- t* : OK
  -- (Valtype_ok: C |- t : OK)*

rule Instrtype_ok:
  C |- t_1* ->_(x*) t_2* : OK
  -- Resulttype_ok: C |- t_1* : OK
  -- Resulttype_ok: C |- t_2* : OK
  -- (if C.LOCALS[x] = lct)*


;; Type expansion

relation Expand: deftype ~~ comptype hint(macro "%expanddt") hint(tabular)
  hint(prose "The :ref:`expansion <aux-expand-deftype>` of %1 is %2")  ;; TODO(3, ?): avoid hardcoding reST

relation Expand_use: typeuse ~~_context comptype  hint(macro "%expandyy") hint(tabular)
  hint(prose "The :ref:`expansion <aux-expand-typeuse>` of %2 is %3")  ;; TODO(3, ?): avoid hardcoding reST

rule Expand: deftype ~~ comptype   -- if $expanddt(deftype) = comptype

rule Expand_use/deftype: deftype ~~_C comptype       -- Expand: deftype ~~ comptype
rule Expand_use/typeidx: _IDX typeidx ~~_C comptype  -- Expand: C.TYPES[typeidx] ~~ comptype


;; Type definitions
 
syntax oktypeidx hint(show OK#((typeidx))) hint(prose_desc "type index") =
  | OK typeidx      hint(show OK#(%))     hint(macro "%subtype")    hint(prose "%1")
syntax oktypeidxnat hint(show OK#(typeidx,n)) =
  | OK typeidx nat  hint(show OK#(%,%))   hint(macro "%subtypeext")

relation Packtype_ok: context |- packtype : OK          hint(name "K-pack")    hint(macro "%packtype")
relation Fieldtype_ok: context |- fieldtype : OK        hint(name "K-field")   hint(macro "%fieldtype")
relation Storagetype_ok: context |- storagetype : OK    hint(name "K-storage") hint(macro "%storagetype")
relation Comptype_ok: context |- comptype : OK          hint(name "K-comp")    hint(macro "%comptype")
relation Subtype_ok: context |- subtype : oktypeidx     hint(name "K-sub")     hint(macro "%subtype")     hint(prosepp "for")
relation Rectype_ok: context |- rectype : oktypeidx     hint(name "K-rect")    hint(macro "%rectype")     hint(prosepp "for")
relation Subtype_ok2: context |- subtype : oktypeidxnat hint(name "K-sub2")    hint(macro "%subtypeext")  hint(prosepp "for")
relation Rectype_ok2: context |- rectype : oktypeidxnat hint(name "K-rec2")    hint(macro "%rectypeext")  hint(prosepp "for")
relation Deftype_ok: context |- deftype : OK            hint(name "K-def")     hint(macro "%deftype")

;; Forward declarations for validation.subtyping
relation Comptype_sub: context |- comptype <: comptype  hint(name "S-comp")    hint(macro "%comptypematch")
relation Deftype_sub: context |- deftype <: deftype     hint(name "S-def")     hint(macro "%deftypematch")


rule Typeuse_ok/typeidx:
  C |- _IDX typeidx : OK
  -- if C.TYPES[typeidx] = dt

rule Typeuse_ok/rec:
  C |- REC i : OK
  -- if C.RECS[i] = st

rule Typeuse_ok/deftype:
  C |- deftype : OK
  -- Deftype_ok: C |- deftype : OK


rule Packtype_ok:
  C |- packtype : OK

rule Storagetype_ok/val:
  C |- valtype : OK
  -- Valtype_ok: C |- valtype : OK

rule Storagetype_ok/pack:
  C |- packtype : OK
  -- Packtype_ok: C |- packtype : OK

rule Fieldtype_ok:
  C |- MUT? storagetype : OK
  -- Storagetype_ok: C |- storagetype : OK


rule Comptype_ok/struct:
  C |- STRUCT fieldtype* : OK
  -- (Fieldtype_ok: C |- fieldtype : OK)*

rule Comptype_ok/array:
  C |- ARRAY fieldtype : OK
  -- Fieldtype_ok: C |- fieldtype : OK

rule Comptype_ok/func:
  C |- FUNC t_1* -> t_2* : OK
  -- Resulttype_ok: C |- t_1* : OK
  -- Resulttype_ok: C |- t_2* : OK


rule Subtype_ok:
  C |- SUB FINAL? (_IDX x)* comptype : OK(x_0)
  -- if |x*| <= 1
  -- (if x < x_0)*
  -- (if $unrolldt(C.TYPES[x]) = SUB (_IDX x')* comptype')*
  ----
  -- Comptype_ok: C |- comptype : OK
  -- (Comptype_sub: C |- comptype <: comptype')*

def $before(typeuse, typeidx, nat) : bool   hint(show % << %,%) hint(macro "before")
def $before(deftype, x, i) = true
def $before(_IDX typeidx, x, i) = typeidx < x
def $before(REC j, x, i) = j < i

def $unrollht(context, heaptype) : subtype  hint(show $unroll_(%,%))
def $unrollht(C, deftype) = $unrolldt(deftype)
def $unrollht(C, _IDX typeidx) = $unrolldt(C.TYPES[typeidx])
def $unrollht(C, REC i) = C.RECS[i]

rule Subtype_ok2:
  C |- SUB FINAL? typeuse* compttype : OK x i
  -- if |typeuse*| <= 1
  -- (if $before(typeuse, x, i))*
  -- (if $unrollht(C, typeuse) = SUB typeuse'* comptype')*
  ----
  -- Comptype_ok: C |- comptype : OK
  -- (Comptype_sub: C |- comptype <: comptype')*


rule Rectype_ok/empty:
  C |- REC eps : OK(x)

rule Rectype_ok/cons:
  C |- REC (subtype_1 subtype*) : OK(x)
  -- Subtype_ok: C |- subtype_1 : OK(x)
  -- Rectype_ok: C |- REC subtype* : OK($(x+1))

rule Rectype_ok/_rec2:
  C |- REC subtype* : OK(x)
  -- Rectype_ok2: C, RECS subtype* |- REC subtype* : OK x 0

rule Rectype_ok2/empty:
  C |- REC eps : OK x i

rule Rectype_ok2/cons:
  C |- REC (subtype_1 subtype*) : OK x i
  -- Subtype_ok2: C |- subtype_1 : OK x i
  -- Rectype_ok2: C |- REC subtype* : OK $(x+1) $(i+1)


rule Deftype_ok:
  C |- _DEF rectype i : OK
  -- Rectype_ok: C |- rectype : OK(x)
  -- if rectype = REC subtype^n
  -- if i < n


;; External types

relation Limits_ok: context |- limits : nat         hint(name "K-limits") hint(macro "%limits")  hint(prosepp "within")
relation Tagtype_ok: context |- tagtype : OK        hint(name "K-tag")    hint(macro "%tagtype")
relation Globaltype_ok: context |- globaltype : OK  hint(name "K-global") hint(macro "%globaltype")
relation Memtype_ok: context |- memtype : OK        hint(name "K-mem")    hint(macro "%memtype")
relation Tabletype_ok: context |- tabletype : OK    hint(name "K-table")  hint(macro "%tabletype")
relation Externtype_ok: context |- externtype : OK  hint(name "K-extern") hint(macro "%externtype")


rule Limits_ok:
  C |- `[n .. m?] : k
  -- if n <= k
  -- (if n <= m <= k)?

rule Tagtype_ok:
  C |- typeuse : OK
  -- Typeuse_ok: C |- typeuse : OK
  -- Expand_use: typeuse ~~_C $($(FUNC t_1* -> t_2*))

rule Globaltype_ok:
  C |- MUT? t : OK
  -- Valtype_ok: C |- t : OK

rule Memtype_ok:
  C |- addrtype limits PAGE : OK
  -- Limits_ok: C |- limits : $(2^($size(addrtype) - 16))

rule Tabletype_ok:
  C |- addrtype limits reftype : OK
  -- Limits_ok: C |- limits : $(2^$size(addrtype) - 1)
  -- Reftype_ok: C |- reftype : OK


rule Externtype_ok/tag:
  C |- TAG tagtype : OK
  -- Tagtype_ok: C |- tagtype : OK

rule Externtype_ok/global:
  C |- GLOBAL globaltype : OK
  -- Globaltype_ok: C |- globaltype : OK

rule Externtype_ok/mem:
  C |- MEM memtype : OK
  -- Memtype_ok: C |- memtype : OK

rule Externtype_ok/table:
  C |- TABLE tabletype : OK
  -- Tabletype_ok: C |- tabletype : OK

rule Externtype_ok/func:
  C |- FUNC typeuse : OK
  -- Typeuse_ok: C |- typeuse : OK
  -- Expand_use: typeuse ~~_C $($(FUNC t_1* -> t_2*))

;; Concurrency
relation Consistentwith: region |- trace Consistentwith 
relation forallconsistentwith: (!) region |- trace Consistentwith
relation Consistent: |- trace Consistent 

relation Readseachfrom: trace region |- event Readseachfrom event* 
relation Readsfrom: trace region nat |- event Readsfrom event 
relation Notear: region |- event Notear event* 
relation Valueconsistent: trace region u32 u32 |- event Valueconsistent event 
relation Hbconsistent: trace region u32 |- event Hbconsistent event 
relation Sclastvisible: trace region |- event Sclastvisible event 
relation Suspensionsconsistent: u32 region |- trace Suspensionsconsistent 
relation Suspensionsconsistentwith: u32 region |- event* Suspensionsconsistentwith timestamp^a 
relation Happensbefore: event Happensbefore event 

;; Placeholder for unspecified foralls
def $allreg : region*   
def $allreg = [(REGLEN u0)]
def $allnat : nat*
def $allnat = [0]

def $consistentwithfunction(region, trace) : bool    hint(show %1 |- %2 Consistentwith)
def $consistentwithfunction(reg, tr) = true -- Consistentwith: reg |- tr Consistentwith
def $consistentwithfunction(reg, tr) = false -- otherwise

def $suspensionsconsistentfunction(u32, region, trace) : bool
def $suspensionsconsistentfunction(u32, reg, trace) = true -- Suspensionsconsistent: u32 reg |- trace Suspensionsconsistent
def $suspensionsconsistentfunction(u32, reg, trace) = false

def $readseachfromfunction(event, trace, region, event*) : bool
def $readseachfromfunction(evt, tr, reg, evt'*) = true -- Readseachfrom: tr reg |- evt Readseachfrom evt'*
def $readseachfromfunction(evt, tr, reg, evt'*) = false -- otherwise

def $readsfromfunction(nat, trace, region, event, event*) : bool
def $readsfromfunction(i, tr, reg, evt, evtx^n) = true 
    -- if i < n 
    -- Readsfrom: tr reg i |- evt Readsfrom evtx^n[i]
def $readsfromfunction(i, tr, reg, evt, evtx*) = false -- otherwise

def $forall1(syntax X, X*, def $p(X) : bool) : bool  hint(show (!) x <- %2. %3#(x))
def $forall1(syntax X, testx*, $p) = true  -- (if $p(testx))*

;; TODO: Dimension error from X and Y both using *?
def $forall2(syntax X, syntax Y, X*, Y*, def $p(X, Y) : bool) : bool  hint(show (!) x <- %3, y <- %4. %5#(x, y))
def $forall2(syntax X, syntax Y, eps, testy*, $p) = true
def $forall2(syntax X, syntax Y, testx_1 testx*, testy*, $p) = $forall2(X, Y, testx*, testy*, $p)
  -- (if $p(testx_1, testy))*

def $forall1and2(syntax X, syntax Y, X*, Y, def $p(X, Y) : bool) : bool  hint(show (!) x <- %3. %5#(x, %4))
def $forall1and2(syntax X, syntax Y, testx*, Y, $p) = true  -- (if $p(testx, Y))*

def $forall1and3(syntax X, syntax Y, syntax Z, X*, Y, Z, def $p(X, Y, Z) : bool) : bool  hint(show (!) x <- %4. %7#(x, %5, %6))
def $forall1and3(syntax X, syntax Y, syntax Z, testx*, y1, z1, $p) = true -- (if $p(testx, y1, z1))*
def $forall1and3(syntax X, syntax Y, syntax Z, testx*, y1, z1, $p) = false -- otherwise

def $forall1and4(syntax X, syntax Y, syntax Z, syntax W, X*, Y, Z, W, def $p(X, Y, Z, W) : bool) : bool  hint(show (!) x <- %5. %9#(x, %7, %8))
def $forall1and4(syntax X, syntax Y, syntax Z, syntax W, testx*, y1, z1, w1, $p) = true -- (if $p(testx, y1, z1, w1))*
def $forall1and4(syntax X, syntax Y, syntax Z, syntax W, testx*, y1, z1, w1, $p) = false -- otherwise

def $forall1and5(syntax X, syntax Y, syntax Z, syntax W, syntax V, X*, Y, Z, W, V, def $p(X, Y, Z, W, V) : bool) : bool  hint(show (!) x <- %4. %7#(x))
def $forall1and5(syntax X, syntax Y, syntax Z, syntax W, syntax V, testx*, y1, z1, w1, v1, $p) = true -- (if $p(testx, y1, z1, w1, v1))*
def $forall1and5(syntax X, syntax Y, syntax Z, syntax W, syntax V, testx*, y1, z1, w1, v1, $p) = false -- otherwise

def $impliesconsistentwith(event, event) : bool  
def $impliesconsistentwith(evt__init, evt) =  $has_init(evt_i) /\ (evt_i =/= evt) /\ $overlap_reg(evt_i, evt) ==> $happensbefore(evt_i, evt)

def $impliestothappensbefore(event, event) : bool
def $impliestothappensbefore(evt1, evt2) = $tot(evt1, evt2) ==> $happensbefore(evt1, evt2)

def $notinrange(u32, u32*) : bool
def $notinrange(k, eps) = true
def $notinrange(k, rangeaddr' rangeaddr*) = false -- if k = rangeaddr'
def $notinrange(k, rangeaddr' rangeaddr*) = true -- if k =/= rangeaddr' /\ $notinrange(k, rangeaddr*)

;; Can express all possible registers as a list? So can use $forall
rule Consistent/init:
  |- tr Consistent 
  -- if $forall1and2(region, trace, $allreg, tr, $consistentwithfunction)

rule Consistentwith/init:
  reg |- tr Consistentwith 
  -- if $forall1and3(u32, region, trace, $unfoldu32(0, $nat$(2^32-1)), reg, tr, $suspensionsconsistentfunction)
  -- --
  -- if read__evt* = $reading_filter(tr)
  -- if trace__writes* = $writefilter(tr)
  -- --
  -- if |trace__writes*| > 0
  -- (if write__evt <- trace__writes*)^n
  -- --
  -- if $forall1and4(event, trace, region, event^n, read__evt*, tr, reg, write__evt^n, $readseachfromfunction)
  -- --
  -- if evt__init^x = $initfilter(tr)
  -- if $forall2(event, event, evt__init^x, tr, $impliesconsistentwith)

rule Readseachfrom/init:
  trace reg |- evt_R Readseachfrom evt_W^n
  -- if |evt_W^n| = |$readingactionfilter(evt_R.ACTIONS)|
  -- if i* = $unfoldnat(0, |evt_W^n|) ;; Used for more faithful version of spec
  -- --
  -- if $forall1and5(nat, trace, region, event, event^n, i*, tr, reg, evt_R, evt_W^n, $readsfromfunction)
  -- --
  -- Notear: reg |- evt_R Notear evt_W^n

rule Readsfrom/init:
  tr reg i |- evt_R Readsfrom evt_W 
  -- if evt_R =/= evt_W
  -- --
  -- if evt_W <- $writefilter(tr)
  -- --
  -- if k <- $unfoldu32(0, $nat$(2^32-1)) ;; HACK!
  -- Valueconsistent: tr reg i k |- evt_R Valueconsistent evt_W
  -- --
  -- Hbconsistent: tr reg k |- evt_R Hbconsistent evt_W
  -- --
  -- Sclastvisible: tr reg |- evt_R Sclastvisible evt_W

rule Valueconsistent/init:
  trace reg i k |- evt_R Valueconsistent evt_W 
  -- if [act_R] = $region_action_filter(reg, evt_R.ACTIONS)
  -- if [act_W] = $region_action_filter(reg, evt_W.ACTIONS)
  -- --
  -- if k = $($offset(act_R) + i)
  -- if j = $(k - $offset(act_W))
  -- --
  -- if read__actions* = $readingactionfilter(evt_R.ACTIONS)
  -- if write__actions* = $writeactionfilter(evt_W.ACTIONS)
  -- --
  -- if read__actions*[i] = write__actions*[j]

rule Hbconsistent/init:
  trace reg k |- evt_R Hbconsistent evt_W
  -- if ~$happensbefore(evt_R, evt_W)
  -- --
  -- if $access2_r(reg, evt_W, evt_R, bool, $sync)
  -- --
  -- if evt_W'* = $writefilter(trace)
  -- --
  -- (if $happensbefore(evt_W, evt_W') /\ $happensbefore(evt_W', evt_R) ==> $notinrange(k, $access1_r(reg, evt_W', u32*, $range)))*

;; TODO: Find if within premise line break possible
rule Sclastvisible/init:
  trace reg |- evt_R Sclastvisible evt_W 
  -- if evt_W'* = $writefilter(trace)
  -- --
  -- (if $happensbefore(evt_R, evt_W) ==>
        $tot(evt_W, evt_W') /\ $tot(evt_W', evt_R) /\ $access2_r(reg, evt_W, evt_R, bool, $sync) ==>
        ~$access2_r(reg, evt_W, evt_R, bool, $sync)
      )*
  -- --
  -- (if $happensbefore(evt_R, evt_W) ==>
        $happensbefore(evt_W, evt_W') /\ $tot(evt_W', evt_R) ==>
        ~$access2_r(reg, evt_W, evt_R, bool, $sync)
      )*
  -- --
  -- (if $happensbefore(evt_R, evt_W) ==>
        $tot(evt_W, evt_W') /\ $happensbefore(evt_W', evt_R) ==>
        ~$access2_r(reg, evt_W, evt_R, bool, $sync)
      )*

rule Notear/init:
  reg |- evt_R Notear evt_W* 
  -- if evt_W'* = $sameandtearfreefilter(reg, evt_R, evt_W*)
  -- if $access1_r(reg, evt_R, bool, $tearfree) ==> |evt_W'*| <= 1

rule Suspensionsconsistent/init:
  i reg |- tr Suspensionsconsistent 
  -- if tr' = $suspfilter(reg, i, tr)
  -- Suspensionsconsistentwith: i reg |- tr' Suspensionsconsistentwith eps
  -- --
  -- if $forall2(event, event, tr', tr', $impliestothappensbefore)

rule Suspensionsconsistentwith/init: 
  i reg |- eps Suspensionsconsistentwith timestamp* 

rule Suspensionsconsistentwith/wait:
  i reg |- evt tr Suspensionsconsistentwith time* 
  -- if $access1_r(reg, evt, action, $id) = (WAIT (reg i ) s64)
  -- --
  -- Suspensionsconsistentwith: i reg |- tr Suspensionsconsistentwith (evt.TIME time*)

rule Suspensionsconsistentwith/timeout:
  i reg |- evt tr Suspensionsconsistentwith (time1^a evt.TIMEp time2^b) 
  -- if $access1_r(reg, evt, action, $id) = (TIMEOUT (reg i))
  -- --
  -- Suspensionsconsistentwith: i reg |- tr Suspensionsconsistentwith (evt.TIME time2^b)

rule Suspensionsconsistentwith/notify:
  i reg |- evt_N evt^n tr Suspensionsconsistentwith (time^m (evt.TIMEp)^n) 
  -- (if $access1_r(reg, evt, action, $id) = (WOKEN (reg i)))^n
  -- -- 
  -- if $access1_r(reg, evt_N, action, $id) = (NOTIFY location n k)
  -- if n < k ==> m = 0
  -- --
  -- Suspensionsconsistentwith: i reg |- tr Suspensionsconsistentwith time^m

