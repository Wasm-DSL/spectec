  -- if $(i + ao.OFFSET + n/8 <= |$mem((s; f), x).BYTES|)

rule Step/atomic.store-num-oob-unshared:
  s; (f; (CONST at i) (CONST inntype c) (ATOMIC.STORE inntype x ao); timestamp)  ~>  s; (f'; TRAP; timestamp')
  ---- ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE

rule Step/atomic.store-num-val-unshared:
  s; (f; (CONST at i) (CONST inntype c) (ATOMIC.STORE inntype x ao); timestamp)  ~>  $c_with_mem((s; f), x, $(i + ao.OFFSET), $($size(inntype)/8), b*); (f'; eps; timestamp')
  ---- ----
