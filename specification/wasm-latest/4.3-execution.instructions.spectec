rule Step_read/memory.size-unshared:
  s; (f; (MEMORY.SIZE x); timestamp)  ~>  f'; (CONST at n); timestamp'
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $(n * $($(64 * $Ki))) = |$mem(s; f, x).BYTES|
  -- if $mem(s; f, x).TYPE = at lim share PAGE

rule Step/memory.grow-succeed-unshared:
  s; (f; (CONST at n) (MEMORY.GROW x); timestamp)  ~>  $c_with_meminst(s; f, x, mi); (f'; (CONST at $(|$mem(s; f, x).BYTES| / $($(64 * $Ki)))); timestamp')
  ----
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if mi = $growmem($mem(s; f, x), n)
  
rule Step/memory.grow-fail-unshared:
  s; (f; (CONST at n) (MEMORY.GROW x); timestamp)  ~>  s; (f'; (CONST at $inv_signed_($size(at), $(-1))); timestamp')
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE

rule Step_read/memory.size-shared:
  s; (f; (MEMORY.SIZE x); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; (CONST at n); timestamp'
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if $(n * $($(64 * $Ki))) = |$mem(s; f, x).BYTES|
  -- if $mem(s; f, x).TYPE = at lim share PAGE

rule Step/memory.grow-succeed-shared:
  s; (f; (CONST at n) (MEMORY.GROW x); timestamp)  ~>_({ 
    ACTIONS (
      (RMW ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|)) (CONST I32 $(|$mem(s; f, x).BYTES| +  $($(n * $($(64 * $Ki)))))))
      (WR SEQCST ((REGLEN a) $(|$mem(s; f, x).BYTES|)) (BYTES (0x00)^$($(n * $($(64 * $Ki))))))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  $c_with_meminst(s; f, x, mi); (f'; (CONST at $(|$mem(s; f, x).BYTES| / $($(64 * $Ki)))); timestamp')
  -- if (
          a = f.MODULE.MEMS[0] 
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if mi = $growmem($mem(s; f, x), n)

rule Step/memory.grow-fail-shared:
  s; (f; (CONST at n) (MEMORY.GROW x); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  s; (f'; (CONST at $inv_signed_($size(at), $(-1))); timestamp')
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE


rule Step_read/memory.fill-oob:
  s; (f; (CONST at i) val (CONST at n) (MEMORY.FILL x); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; TRAP; timestamp'
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE 
  -- if $(i + n) > |$mem(s; f, x).BYTES|

rule Step_read/memory.fill-zero:
  s; (f; (CONST at i) val (CONST at n) (MEMORY.FILL x); timestamp)  ~> f'; eps; timestamp'
  -- otherwise
  -- if n = 0
  -- if ($mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE /\ |$mem(s; f, 0).BYTES| = |$mem(s; f, x).BYTES|)

rule Step_read/memory.fill-succ:
  s; (f; (CONST at i) val (CONST at n) (MEMORY.FILL x); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f; 
  (CONST at i) val (STORE I32 `8 x $memarg0)
  (CONST at $(i+1)) val (CONST at $(n-1)) (MEMORY.FILL x)
  ; timestamp'
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE 

rule Step_read/memory.copy-oob:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (MEMORY.COPY x_1 x_2); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; TRAP; timestamp'
  ---- ----
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE 
  -- if $(i_1 + n) > |$mem(s; f, x_1).BYTES| \/ $(i_2 + n) > |$mem(s; f, x_2).BYTES|

rule Step_read/memory.copy-zero:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (MEMORY.COPY x_1 x_2); timestamp)  ~>  f'; eps; timestamp'
  -- otherwise
  -- if ($mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE /\ |$mem(s; f, 0).BYTES| = |$mem(s; f, x).BYTES|)
  -- if n = 0

rule Step_read/memory.copy-le:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (MEMORY.COPY x_1 x_2); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
    f;
    (CONST at_1 i_1) (CONST at_2 i_2) (LOAD I32 (`8 _ U) x_2 $memarg0) (STORE I32 `8 x_1 $memarg0)
    (CONST at_1 $(i_1 + 1)) (CONST at_2 $(i_2 + 1)) (CONST at' $(n - 1)) (MEMORY.COPY x_1 x_2);
    timestamp
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE 
  -- if i_1 <= i_2

rule Step_read/memory.copy-gt:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (MEMORY.COPY x_1 x_2); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
    f;
    (CONST at_1 $(i_1+n-1)) (CONST at_2 $(i_2+n-1)) (LOAD I32 (`8 _ U) x_2 $memarg0) (STORE I32 `8 x_1 $memarg0)
    (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' $(n-1)) (MEMORY.COPY x_1 x_2);
    timestamp
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE 


rule Step_read/memory.init-oob:
  s; (f; (CONST at i) (CONST I32 j) (CONST I32 n) (MEMORY.INIT x y); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; TRAP; timestamp'
  ---- ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if $(i + n) > |$mem(s; f, x).BYTES| \/ $(j + n) > |$data(s; f, y).BYTES|

rule Step_read/memory.init-zero:
  s; (f; (CONST at i) (CONST I32 j) (CONST I32 n) (MEMORY.INIT x y); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; eps; timestamp'
  -- otherwise
  -- if ($mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE /\ |$mem(s; f, 0).BYTES| = |$mem(s; f, x).BYTES|)
  -- if n = 0

rule Step_read/memory.init-succ:
  s; (f; (CONST at i) (CONST I32 j) (CONST I32 n) (MEMORY.INIT x y); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })     
  f;  
  (CONST at i) (CONST I32 $data(s; f,y).BYTES[j]) (STORE I32 `8 x $memarg0)
  (CONST at $(i+1)) (CONST I32 $(j+1)) (CONST I32 $(n-1)) (MEMORY.INIT x y);
  timestamp
  -- otherwise 
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE

rule Step/data.drop:
  s; (f; (DATA.DROP x); timestamp)  ~>  $c_with_data((s; f), x, eps); (f'; eps; timestamp')

;; Atomic Memory instructions


rule Step_read/atomic.load-num-oob-unshared:
  s; (f; (CONST at i) (ATOMIC.LOAD inntype x ao); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  
rule Step_read/atomic.load-num-val-unshared:
  s; (f; (CONST at i) (ATOMIC.LOAD inntype x ao); timestamp)  ~>  f'; (CONST inntype c); timestamp'
  ---- ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $ibytes_($size(inntype), c) = $mem((s; f), x).BYTES[i + ao.OFFSET : $size(inntype)/8]
  -- if $((i + ao.OFFSET) \ $size(inntype)/8) = 0
  -- if $(i + ao.OFFSET + $size(inntype)/8 <= |$mem((s; f), x).BYTES|)

rule Step_read/atomic.load-pack-oob-unshared:
  s; (f; (CONST at i) (ATOMIC.LOAD inntype (n _ U) x ao); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE

rule Step_read/atomic.load-pack-val-unshared:
  s; (f; (CONST at i) (ATOMIC.LOAD inntype (n _ U) x ao); timestamp)  ~>  f'; (CONST inntype $extend__(n, $size(inntype), U, c)); timestamp'
  ---- ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $ibytes_(n, c) = $mem((s; f), x).BYTES[i + ao.OFFSET : n/8]
  -- if $((i + ao.OFFSET) \ n/8) = 0
  -- if $(i + ao.OFFSET + n/8 <= |$mem((s; f), x).BYTES|)

rule Step_read/atomic.load-num-oob-shared:
  s; (f; (CONST at i) (ATOMIC.LOAD inntype x ao); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ),  
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; TRAP; timestamp'
  ---- ----
  -- otherwise
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE

rule Step_read/atomic.load-num-val-shared:
  s; (f; (CONST at i) (ATOMIC.LOAD inntype x ao); timestamp)  ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RD ord ((REGDATA a) ea) (BYTES bytes) notears?), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; (CONST inntype c); timestamp'
  ---- ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if $ibytes_($size(inntype), c) = $mem((s; f), x).BYTES[i + ao.OFFSET : $size(inntype)/8]
  -- if $((i + ao.OFFSET) \ n/8) = 0
  -- if $(i + ao.OFFSET + $size(inntype)/8 <= |$mem((s; f), x).BYTES|)

rule Step_read/atomic.load-pack-oob-shared:
  s; (f; (CONST at i) (ATOMIC.LOAD inntype (n _ U) x ao); timestamp)  ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
