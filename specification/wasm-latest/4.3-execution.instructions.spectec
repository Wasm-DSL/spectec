          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if d = c
  -- if $ibytes_(n, d) = $mem((s; f), x).BYTES[i + ao.OFFSET : n/8]
  -- if b* = $ibytes_(n, $wrap__($size(inntype), n, g))
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/atomic.rmw.cmpxchg-num-notequals-pack-unshared:
  s; (f; (CONST at i) (CONST inntype c) (CONST inntype g) (ATOMIC.RMW.CMPXCHG inntype n x ao); timestamp) ~> 
  s; (f; (CONST inntype d); timestamp)
  ---- ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if d =/= c
  -- if $ibytes_(n, d) = $mem((s; f), x).BYTES[i + ao.OFFSET : n/8]
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/memory.atomic.notify-oob-unshared:
  s; (f; (CONST at i) (CONST I32 count) (MEMORY.ATOMIC.NOTIFY x ao); timestamp) ~> s; (f'; TRAP; timestamp')
  ---- ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $(i + ao.OFFSET + $size(I32)/8) > |$mem((s; f), x).BYTES|
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/memory.atomic.notify-unshared:
  s; (f; (CONST at i) (CONST I32 count) (MEMORY.ATOMIC.NOTIFY x ao); timestamp) ~> s; (f'; (CONST I32 0); timestamp')
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|


rule Step/atomic.rmw-num-oob-shared:
  s; (f;  (CONST at i) (CONST inntype c) (ATOMIC.RMW inntype rmwop x ao); timestamp) ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ), 
    TIMEp timestamp, 
    TIME timestamp'
  })
  s; (f; TRAP; timestamp)
  ---- ----
  -- otherwise
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE

rule Step/atomic.rmw-num-val-shared:
  s; (f; (CONST at i) (CONST inntype c) (ATOMIC.RMW inntype rmwop x ao); timestamp) ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RMW ((REGDATA a) ea) (BYTES $mem(s; f, x).BYTES) (BYTES b*)), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  $c_with_mem((s; f), x, $(i + ao.OFFSET), $($size(inntype)/8), b*); (f; (CONST inntype d); timestamp)
  ---- ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if j = $rmwop_(inntype, rmwop, c, d)
  -- if b* = $ibytes_($size(inntype), j)
  -- if $ibytes_($size(inntype), d) = $mem((s; f), x).BYTES[i + ao.OFFSET : $size(inntype)/8]
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/atomic.rmw-num-pack-shared:
  s; (f; (CONST at i) (CONST inntype c) (ATOMIC.RMW inntype n rmwop x ao); timestamp) ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RMW ((REGDATA a) ea) (BYTES $mem(s; f, x).BYTES) (BYTES b*)), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  $c_with_mem((s; f), x, $(i + ao.OFFSET), $(n/8), b*); (f; (CONST inntype d); timestamp)
  ---- ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if j = $rmwop_($inv_jsize(n), rmwop, $wrap__($size(inntype), n, c), $wrap__($size(inntype), n, d))
  -- if b* = $ibytes_(n, $extend__(n, $size(inntype), U, j))
  -- if $ibytes_(n, d) = $mem((s; f), x).BYTES[i + ao.OFFSET : n/8]
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/atomic.rmw.cmpxchg-num-oob-shared:
  s; (f;  (CONST at i) (CONST inntype c) (CONST inntype g) (ATOMIC.RMW.CMPXCHG inntype x ao); timestamp) ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  s; (f; TRAP; timestamp)
  ---- ----
  -- otherwise
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE

rule Step/atomic.rmw.cmpxchg-num-equals-val-shared:
  s; (f; (CONST at i) (CONST inntype c) (CONST inntype g) (ATOMIC.RMW.CMPXCHG inntype x ao); timestamp) ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RMW ((REGDATA a) ea) (BYTES $mem(s; f, x).BYTES) (BYTES b*)), 
    TIMEp timestamp, 
    TIME timestamp'
  })   
  $c_with_mem((s; f), x, $(i + ao.OFFSET), $($size(inntype)/8), b*); (f; (CONST inntype d); timestamp)
  ---- ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if d = c
  -- if $ibytes_($size(inntype), d) = $mem((s; f), x).BYTES[i + ao.OFFSET : $size(inntype)/8]
  -- if b* = $ibytes_($size(inntype), g)
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/atomic.rmww.cmpxchg-num-notequals-val-shared:
  s; (f; (CONST at i) (CONST inntype c) (CONST inntype g) (ATOMIC.RMW.CMPXCHG inntype x ao); timestamp) ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RMW ((REGDATA a) ea) (BYTES $mem(s; f, x).BYTES) (BYTES b*)), 
