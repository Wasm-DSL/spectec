  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if d =/= c
  -- if $ibytes_($size(inntype), d) = $mem((s; f), x).BYTES[i + ao.OFFSET : $size(inntype)/8]
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/atomic.rmw.cmpxchg-num-equals-pack-shared:
  s; (f; (CONST at i) (CONST inntype c) (CONST inntype g) (ATOMIC.RMW.CMPXCHG inntype n x ao); timestamp) ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
