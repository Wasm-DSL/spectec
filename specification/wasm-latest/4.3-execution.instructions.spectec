rule Step/atomic.rmw-num-oob-unshared:
  s; (f;  (CONST at i) (CONST inntype c) (ATOMIC.RMW inntype rmwop x ao); timestamp) ~> 
  s; (f; TRAP; timestamp)
  ---- ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE

