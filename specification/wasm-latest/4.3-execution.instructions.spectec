;;
;; Execution of Instructions
;;

;; Concurrency TODO: Add emit event or action thing

;; Wrapper around

relation Global_step: config ~>_(event?) config    hint(name "E") hint(macro "globalstepto") hint(tabular)
relation Step: lconfig ~>_(event?) lconfig       hint(name "E") hint(macro "stepto") hint(tabular)
relation Step_pure: thread* ~>_(event?) thread*  hint(name "E") hint(macro "stepto") hint(tabular)
;; Concurrency TODO: Is this Step_read conversion to concurrent version correct? 
relation Step_read: lconfig ~>_(event?) thread*  hint(name "E") hint(macro "stepto") hint(tabular)
relation Steps: lconfig ~>*_(event*) lconfig     hint(name "E") hint(macro "steptostar") hint(tabular)


;; Structural
rule Global_step/lift:
  s; thread^a (f; instr^b; timestamp) thread_1^c ~>_({ACTIONS act^d, TIMEp timestamp, TIME timestamp'}) s; thread^a (f'; instr'^a1; timestamp') thread_1^c 
  -- Step: lconfig ~>_({ACTIONS act^d, TIMEp timestamp, TIME timestamp'}) lconfig'
  -- if $timestamphappensbefore(timestamp, timestamp')
  -- (if act =/= SPAWN)^d

rule Step/pure:
  s; thread  ~>_(event?)  s; thread'
  -- Step_pure: thread ~>_(event?) thread'

rule Step/read:
  s; thread  ~>_(event?)  s; thread'
  -- Step_read: s; thread ~>_(event?) thread'

rule Steps/refl:
  s; thread ~>*_(event?) s; thread

rule Steps/trans:
  s; thread  ~>*_(event?)  s''; thread''
  -- Step: s; thread  ~>_(event?)  s'; thread'
  -- Steps: s'; thread'  ~>*_(event?)  s''; thread''

;; Context

;; Concurrency TODO: Is dimensionality wrong? Original uses all * too. Also context rules emit act* but not timestamps based on web spec?

rule Step/ctxt-instrs:
  s; (f; val* instr* instr_1*; timestamp) ~>_(event?)  s'; (f'; val* instr'* instr_1*; timestamp')
  -- Step: s; (f; instr*; timestamp) ~>_(event?)  s'; (f'; instr'*; timestamp')
  -- if val* =/= eps \/ instr_1* =/= eps

rule Step/ctxt-label:
  s; (f; (LABEL_ n `{instr_0*} instr*); timestamp) ~>_(event?) s'; (f'; (LABEL_ n `{instr_0*}) instr'*; timestamp') 
  -- Step: s; (f; instr*; timestamp) ~>_(event?) s'; (f'; instr'*; timestamp') 

rule Step/ctxt-handler:
  s; (f; (HANDLER_ n `{catch*} instr*); timestamp) ~>_(event?) s'; (f'; (HANDLER_ n `{catch*} instr'*); timestamp')
  -- Step: s; (f; instr*; timestamp) ~>_(event?) s'; (f'; instr'*; timestamp')

rule Step/ctxt-frame:
  s; (f; (FRAME_ n `{f'}) instr*; timestamp) ~>_(event?)  s'; (f'; (FRAME_ n `{f''}) instr'*; timestamp')
  -- Step: s; (f; instr*; timestamp) ~>_(event?) s'; (f'; instr'*; timestamp' ) 


;; Polymorphic instructions

;; Concurrency TODO: Assume s and frame don't change but timestamp does.
rule Step_pure/unreachable:
  f; UNREACHABLE; timestamp ~> f'; TRAP; timestamp'
  
rule Step_pure/nop:
  f; NOP; timestamp ~> f'; eps; timestamp' 

rule Step_pure/drop:
  f; val DROP; timestamp  ~>  f'; eps; timestamp'

rule Step_pure/select-true:
  f; val_1 val_2 (CONST I32 c) (SELECT (t*)?); timestamp ~> f'; val_1; timestamp'
  -- if c =/= 0

rule Step_pure/select-false:
  f; val_1 val_2 (CONST I32 c) (SELECT (t*)?); timestamp  ~> f'; val_2; timestamp'
  -- if c = 0


;; Block instructions

def $blocktype_(state, blocktype) : instrtype hint(macro "fblocktype")
def $blocktype_(z, _IDX x) = t_1* -> t_2*  -- Expand: $type(z, x) ~~ FUNC t_1* -> t_2*
def $blocktype_(z, _RESULT t?) = eps -> t?

rule Step_read/block:
  s; (f;  val^m (BLOCK bt instr*); timestamp) ~> f'; (LABEL_ n `{eps} val^m) instr*; timestamp'
  -- if $blocktype_((s; f), bt) = t_1^m -> t_2^n

rule Step_read/loop:
  s; (f; val^m (LOOP bt instr*); timestamp) ~> f'; (LABEL_ m `{LOOP bt instr*} val^m instr*); timestamp'
  -- if $blocktype_((s; f), bt) = t_1^m -> t_2^n

rule Step_pure/if-true:
  f; (CONST I32 c) (IF bt instr_1* ELSE instr_2*); timestamp  ~> f'; (BLOCK bt instr_1*); timestamp'
  -- if c =/= 0

rule Step_pure/if-false:
  f; (CONST I32 c) (IF bt instr_1* ELSE instr_2*); timestamp  ~>  f'; (BLOCK bt instr_2*); timestamp'
  -- if c = 0

rule Step_pure/label-vals:
  f; (LABEL_ n `{instr*} val*); timestamp  ~>  f'; val*; timestamp'


;; Branch instructions

;; TODO(4, rossberg): may want a label context instead of bubbling up
rule Step_pure/br-label-zero:
  f; (LABEL_ n `{instr'*} val'* val^n (BR l) instr*); timestamp  ~>  f'; val^n instr'*; timestamp'
  -- if l = 0

rule Step_pure/br-label-succ:
  f; (LABEL_ n `{instr'*} val* (BR l) instr*); timestamp  ~>  f'; val* (BR $(l - 1)); timestamp'
  -- if l > 0

rule Step_pure/br-handler:
  f; (HANDLER_ n `{catch*} val* (BR l) instr*); timestamp  ~>  f'; val* (BR l); timestamp'


rule Step_pure/br_if-true:
  f; (CONST I32 c) (BR_IF l); timestamp ~> f'; (BR l); timestamp'
  -- if c =/= 0

rule Step_pure/br_if-false:
  f; (CONST I32 c) (BR_IF l); timestamp  ~>  f'; eps; timestamp'
  -- if c = 0


rule Step_pure/br_table-lt:
  f; (CONST I32 i) (BR_TABLE l* l'); timestamp  ~>  f'; (BR l*[i]); timestamp'
  -- if i < |l*|

rule Step_pure/br_table-ge:
  f; (CONST I32 i) (BR_TABLE l* l'); timestamp  ~>  f'; (BR l'); timestamp'
  -- if i >= |l*|


rule Step_pure/br_on_null-null:
  f; val (BR_ON_NULL l); timestamp ~> f'; (BR l); timestamp'
  -- if val = REF.NULL_ADDR

rule Step_pure/br_on_null-addr:
  f; val (BR_ON_NULL l); timestamp ~> f'; val; timestamp'
  -- otherwise


rule Step_pure/br_on_non_null-null:
  f; val (BR_ON_NON_NULL l); timestamp ~> f'; eps; timestamp'
  -- if val = REF.NULL_ADDR

rule Step_pure/br_on_non_null-addr:
  f; val (BR_ON_NON_NULL l); timestamp ~> f'; val (BR l); timestamp'
  -- otherwise


rule Step_read/br_on_cast-succeed:
  s; (f; ref (BR_ON_CAST l rt_1 rt_2); timestamp)  ~> f'; ref (BR l); timestamp'
  ;; TODO(3, rossberg): -- Ref_ok: s |- ref : $inst_reftype(f.MODULE, rt_2)
  -- Ref_ok: s |- ref : rt
  -- Reftype_sub: {} |- rt <: $inst_reftype(f.MODULE, rt_2)

rule Step_read/br_on_cast-fail:
  s; (f; ref (BR_ON_CAST l rt_1 rt_2); timestamp)  ~> f'; ref; timestamp'
  -- otherwise


rule Step_read/br_on_cast_fail-succeed:
  s; (f; ref (BR_ON_CAST_FAIL l rt_1 rt_2); timestamp)  ~> f'; ref; timestamp'
  ;; TODO(3, rossberg): -- Ref_ok: s |- ref : $inst_reftype(f.MODULE, rt_2)
  -- Ref_ok: s |- ref : rt
  -- Reftype_sub: {} |- rt <: $inst_reftype(f.MODULE, rt_2)

rule Step_read/br_on_cast_fail-fail:
  s; (f; ref (BR_ON_CAST_FAIL l rt_1 rt_2); timestamp)  ~> f'; ref (BR l); timestamp'
  -- otherwise


;; Function instructions

rule Step_read/call:
  s; (f; (CALL x); timestamp)  ~> f'; (REF.FUNC_ADDR a) (CALL_REF $funcinst(s; f)[a].TYPE); timestamp'
  -- if $moduleinst(s; f).FUNCS[x] = a

rule Step_read/call_ref-null:
  s; (f; (REF.NULL_ADDR) (CALL_REF yy); timestamp)  ~> f'; TRAP; timestamp'

rule Step_read/call_ref-func:
  s; (f; val^n (REF.FUNC_ADDR a) (CALL_REF yy); timestamp)  ~> f; (FRAME_ m `{f} (LABEL_ m `{eps} instr*)); timestamp'
  ----
  -- if $funcinst(s; f)[a] = fi
  -- Expand: fi.TYPE ~~ FUNC t_1^n -> t_2^m
  -- if fi.CODE = FUNC x (LOCAL t)* (instr*)
  -- if f = {LOCALS val^n ($default_(t))*, MODULE fi.MODULE}


rule Step_read/return_call:
  s; (f; (RETURN_CALL x); timestamp)  ~> f'; (REF.FUNC_ADDR a) (RETURN_CALL_REF $funcinst(s; f)[a].TYPE); timestamp'
  -- if $moduleinst(s; f).FUNCS[x] = a


rule Step_read/return_call_ref-label:
  s; (f; (LABEL_ k `{instr'*} val* (RETURN_CALL_REF yy) instr*); timestamp)  ~> f'; val* (RETURN_CALL_REF yy); timestamp'

rule Step_read/return_call_ref-handler:
  s; (f; (HANDLER_ k `{catch*} val* (RETURN_CALL_REF yy) instr*); timestamp)  ~> f'; val* (RETURN_CALL_REF yy); timestamp'

rule Step_read/return_call_ref-frame-null:
  s; (f; (FRAME_ k `{f} val* (REF.NULL_ADDR) (RETURN_CALL_REF yy) instr*); timestamp)  ~> f'; TRAP; timestamp'

rule Step_read/return_call_ref-frame-addr:
  s; (f; (FRAME_ k `{f} val'* val^n (REF.FUNC_ADDR a) (RETURN_CALL_REF yy) instr*); timestamp)  ~> f'; val^n (REF.FUNC_ADDR a) (CALL_REF yy); timestamp'
  ----
  -- Expand: $funcinst(s; f)[a].TYPE ~~ FUNC t_1^n -> t_2^m

rule Step_pure/call_indirect:
  f; (CALL_INDIRECT x yy); timestamp  ~>  f'; (TABLE.GET x) (REF.CAST (REF NULL yy)) (CALL_REF yy); timestamp'

rule Step_pure/return_call_indirect:
  f; (RETURN_CALL_INDIRECT x yy); timestamp  ~> f'; (TABLE.GET x) (REF.CAST (REF NULL yy)) (RETURN_CALL_REF yy); timestamp'


rule Step_pure/frame-vals:
  f; (FRAME_ n `{f} val^n); timestamp  ~>  f'; val^n; timestamp'

rule Step_pure/return-frame:
  f; (FRAME_ n `{f} val'* val^n RETURN instr*); timestamp  ~>  f'; val^n; timestamp'

rule Step_pure/return-label:
  f; (LABEL_ n `{instr'*} val* RETURN instr*); timestamp  ~>  f'; val* RETURN; timestamp'

rule Step_pure/return-handler:
  f; (HANDLER_ n `{catch*} val* RETURN instr*); timestamp  ~>  f'; val* RETURN; timestamp'


;; Exceptions

rule Step/throw:
  s; (f; val^n (THROW x); timestamp)  ~>  s[.EXNS =++ exn]; (f'; (REF.EXN_ADDR a) THROW_REF; timestamp')
  -- Expand: $as_deftype($tag(s; f, x).TYPE) ~~ FUNC t^n -> eps
  -- if a = |$exninst(s; f)|
  -- if exn = {TAG $tagaddr(s; f)[x], FIELDS val^n}

rule Step_read/throw_ref-null:
  s; (f; (REF.NULL_ADDR) THROW_REF; timestamp)  ~> f'; TRAP; timestamp'

rule Step_read/throw_ref-instrs:
  s; (f; val* (REF.EXN_ADDR a) THROW_REF instr*; timestamp)  ~>  f'; (REF.EXN_ADDR a) THROW_REF; timestamp'
  ----
  -- if val* =/= eps \/ instr* =/= eps

rule Step_read/throw_ref-label:
  s; (f; (LABEL_ n `{instr'*} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; (REF.EXN_ADDR a) THROW_REF; timestamp'

rule Step_read/throw_ref-frame:
  s; (f; (FRAME_ n `{f} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; (REF.EXN_ADDR a) THROW_REF; timestamp'

rule Step_read/throw_ref-handler-empty:
  s; (f; (HANDLER_ n `{eps} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; (REF.EXN_ADDR a) THROW_REF; timestamp'

rule Step_read/throw_ref-handler-catch:
  s; (f; (HANDLER_ n `{(CATCH x l) catch'*} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; val* (BR l); timestamp'
  ----
  -- if $exninst(s; f)[a].TAG = $tagaddr(s; f)[x]
  -- if val* = $exninst(s; f)[a].FIELDS

rule Step_read/throw_ref-handler-catch_ref:
  s; (f; (HANDLER_ n `{(CATCH_REF x l) catch'*} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; val* (REF.EXN_ADDR a) (BR l); timestamp'
  ----
  -- if $exninst(s; f)[a].TAG = $tagaddr(s; f)[x]
  -- if val* = $exninst(s; f)[a].FIELDS

rule Step_read/throw_ref-handler-catch_all:
  s; (f; (HANDLER_ n `{(CATCH_ALL l) catch'*} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; (BR l); timestamp'

rule Step_read/throw_ref-handler-catch_all_ref:
  s; (f; (HANDLER_ n `{(CATCH_ALL_REF l) catch'*} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; (REF.EXN_ADDR a) (BR l); timestamp'

rule Step_read/throw_ref-handler-next:
  s; (f; (HANDLER_ n `{catch catch'*} (REF.EXN_ADDR a) THROW_REF); timestamp)  ~>  f'; (HANDLER_ n `{catch'*} (REF.EXN_ADDR a) THROW_REF); timestamp'
  ----
  -- otherwise

rule Step_read/try_table:
  s; (f; val^m (TRY_TABLE bt catch* instr*); timestamp)  ~>  f'; (HANDLER_ n `{catch*} (LABEL_ n `{eps} val^m instr*)); timestamp'
  ----
  -- if $blocktype_((s; f), bt) = t_1^m -> t_2^n

rule Step_pure/handler-vals:
  f; (HANDLER_ n `{catch*} val*); timestamp  ~>  f'; val*; timestamp'


;; Traps

rule Step_pure/trap-instrs:
  f; val* TRAP instr*; timestamp  ~>  f'; TRAP; timestamp'
  -- if val* =/= eps \/ instr* =/= eps

rule Step_pure/trap-label:
  f; (LABEL_ n `{instr'*} TRAP); timestamp  ~>  f'; TRAP; timestamp'

rule Step_pure/trap-handler:
  f; (HANDLER_ n `{catch*} TRAP); timestamp  ~>  f'; TRAP; timestamp'

rule Step_pure/trap-frame:
  f; (FRAME_ n `{f} TRAP); timestamp  ~>  f'; TRAP; timestamp'


;; Local instructions

rule Step_read/local.get:
  s; (f; (LOCAL.GET x); timestamp)  ~>  f; val; timestamp'
  -- if $local(s; f, x) = val

rule Step/local.set:
  s; (f; val (LOCAL.SET x); timestamp)  ~>  s; (f[.LOCALS[x] = v]; eps; timestamp')

rule Step_pure/local.tee:
  f; val (LOCAL.TEE x); timestamp  ~>  f'; val val (LOCAL.SET x); timestamp'


;; Global instructions

rule Step_read/global.get:
  s; (f; (GLOBAL.GET x); timestamp)  ~> f; val; timestamp'
  -- if $global(s; f, x).VALUE = val

rule Step/global.set:
  s; (f; val (GLOBAL.SET x); timestamp)  ~>  s[.GLOBALS[f.MODULE.GLOBALS[x]].VALUE = v]; (f; eps; timestamp')


;; Table instructions

rule Step_read/table.get-oob:
  s; (f; (CONST at i) (TABLE.GET x); timestamp)  ~> f'; TRAP; timestamp'
  -- if i >= |$table(s; f, x).REFS|

rule Step_read/table.get-val:
  s; (f; (CONST at i) (TABLE.GET x); timestamp)  ~>  f'; ($table(s; f,x).REFS[i]); timestamp'
  -- if i < |$table(s; f, x).REFS|

rule Step/table.set-oob:
  s; (f; (CONST at i) ref (TABLE.SET x); timestamp)  ~>  s; (f'; TRAP; timestamp')
  -- if i >= |$table(s; f, x).REFS|

rule Step/table.set-val:
  s; (f; (CONST at i) ref (TABLE.SET x); timestamp)  ~>  s[.TABLES[f.MODULE.TABLES[x]].REFS[i] = r]; (f'; eps; timestamp')
  -- if i < |$table(s; f, x).REFS|


rule Step_read/table.size:
  s; (f; (TABLE.SIZE x); timestamp)  ~> f; (CONST at n); timestamp'
  -- if |$table(s; f, x).REFS| = n
  -- if $table(s; f, x).TYPE = at lim rt


rule Step/table.grow-succeed:
  s; (f; ref (CONST at n) (TABLE.GROW x); timestamp)  ~> s[.TABLES[f.MODULE.TABLES[x]].REFS[i] = r]; (f; (CONST at $(|$table(s; f, x).REFS|)); timestamp')
  ----
  -- if ti = $growtable($table(s; f, x), n, ref)

rule Step/table.grow-fail:
  s; (f; ref (CONST at n) (TABLE.GROW x); timestamp)  ~>  s; (f; (CONST at $inv_signed_($size(at), $(-1))); timestamp')


rule Step_read/table.fill-oob:
  s; (f; (CONST at i) val (CONST at n) (TABLE.FILL x); timestamp)  ~> f'; TRAP; timestamp'
  -- if $(i + n) > |$table(s; f, x).REFS|

rule Step_read/table.fill-zero:
  s; (f; (CONST at i) val (CONST at n) (TABLE.FILL x); timestamp)  ~>  f'; eps; timestamp'
  -- otherwise
  -- if n = 0

rule Step_read/table.fill-succ:
  s; (f; (CONST at i) val (CONST at n) (TABLE.FILL x); timestamp)  ~>
    f; (CONST at i) val (TABLE.SET x)
    (CONST at $(i+1)) val (CONST at $(n-1)) (TABLE.FILL x); timestamp
  -- otherwise


rule Step_read/table.copy-oob:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (TABLE.COPY x_1 x_2); timestamp)  ~> f; TRAP; timestamp'
  ---- ----
  -- if $(i_1 + n) > |$table(s; f, x_1).REFS| \/ $(i_2 + n) > |$table(s; f, x_2).REFS|

rule Step_read/table.copy-zero:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (TABLE.COPY x y); timestamp)  ~>  f; eps; timestamp'
  -- otherwise
  -- if n = 0

rule Step_read/table.copy-le:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (TABLE.COPY x y); timestamp)  ~>
    f; (CONST at_1 i_1) (CONST at_2 i_2) (TABLE.GET y) (TABLE.SET x)
    (CONST at_1 $(i_1+1)) (CONST at_2 $(i_2+1)) (CONST at' $(n-1)) (TABLE.COPY x y); timestamp'
  -- otherwise
  -- if i_1 <= i_2

rule Step_read/table.copy-gt:
  s; (f; (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' n) (TABLE.COPY x y); timestamp)  ~>
    f; (CONST at_1 $(i_1+n-1)) (CONST at_2 $(i_2+n-1)) (TABLE.GET y) (TABLE.SET x)
    (CONST at_1 i_1) (CONST at_2 i_2) (CONST at' $(n-1)) (TABLE.COPY x y); timestamp'
  -- otherwise


rule Step_read/table.init-oob:
  s; (f; (CONST at i) (CONST I32 j) (CONST I32 n) (TABLE.INIT x y); timestamp)  ~>  f; TRAP; timestamp'
  ---- ----
  -- if $(i + n) > |$table(s; f, x).REFS| \/ $(j + n) > |$elem(s; f, y).REFS|

rule Step_read/table.init-zero:
  s; (f; (CONST at i) (CONST I32 j) (CONST I32 n) (TABLE.INIT x y); timestamp)  ~>  f; eps; timestamp'
  -- otherwise
  -- if n = 0

rule Step_read/table.init-succ:
  s; (f; (CONST at i) (CONST I32 j) (CONST I32 n) (TABLE.INIT x y); timestamp)  ~>
    f; (CONST at i) $elem(s; f,y).REFS[j] (TABLE.SET x)
    (CONST at $(i+1)) (CONST I32 $(j+1)) (CONST I32 $(n-1)) (TABLE.INIT x y); timestamp'
  -- otherwise


rule Step/elem.drop:
  s; (f; (ELEM.DROP x); timestamp)  ~>  s[.ELEMS[f.MODULE.ELEMS[x]].REFS = r*]; (f; eps; timestamp')


;; Memory instructions

rule Step_read/load-num-oob-unshared:
  s; (f; (CONST at i) (LOAD nt x ao); timestamp)  ~>  f; TRAP; timestamp'
  ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE

rule Step_read/load-num-val-unshared:
  s; (f; (CONST at i) (LOAD nt x ao); timestamp)  ~>  f'; (CONST nt c); timestamp'
  ----
  -- if (
          ord = UNORD 
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $nbytes_(nt, c) = $mem(s; f, x).BYTES[ea : $size(nt)/8]
  -- if $(i + ao.OFFSET + $size(nt)/8 <= |$mem(s; f, x).BYTES|)

rule Step_read/load-pack-oob-unshared:
  s; (f; (CONST at i) (LOAD Inn (n _ sx) x ao); timestamp)  ~>  f'; TRAP; timestamp'
  ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE

rule Step_read/load-pack-val-unshared:
  s; (f; (CONST at i) (LOAD Inn (n _ sx) x ao); timestamp)  ~>  f'; (CONST Inn $extend__(n, $size(Inn), sx, c)); timestamp'
  ----
  -- if (
          ord = UNORD 
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $ibytes_(n, c) = $mem(s; f, x).BYTES[ea : n/8]
  -- if $(i + ao.OFFSET + n/8 <= |$mem(s; f, x).BYTES|)

rule Step_read/load-num-oob-shared:
  s; (f; (CONST at i) (LOAD nt x ao); timestamp)  ~>_({
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ), 
    TIMEp timestamp,
    TIME timestamp'
  })  
  f; TRAP; timestamp'
  ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE

rule Step_read/load-num-val-shared:
  s; (f; (CONST at i) (LOAD nt x ao); timestamp)  ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RD ord ((REGDATA a) ea) (BYTES bytes) notears?), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; (CONST nt c); timestamp'
  ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = UNORD /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |$mem(s; f, x).BYTES|
        )
  -- if storemem.TYPE = addrtype limits SHARED PAGE
  -- if bytes = storemem.BYTES[ea : $size(nt)/8]
  -- if $nbytes_(nt, c) = bytes
  -- if $(i + ao.OFFSET + $size(nt)/8 <= nlen)

rule Step_read/load-pack-oob-shared:
  s; (f; (CONST at i) (LOAD Inn (n _ sx) x ao); timestamp)  ~>_({
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ), 
    TIMEp timestamp,
    TIME timestamp'
  })  
  f'; TRAP; timestamp'
  ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE

rule Step_read/load-pack-val-shared:
  s; (f; (CONST at i) (LOAD Inn (n _ sx) x ao); timestamp)  ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RD ord ((REGDATA a) ea) (BYTES bytes) notears?), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  f'; (CONST Inn $extend__(n, $size(Inn), sx, c)); timestamp'
  ----
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = UNORD /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET)
        )
