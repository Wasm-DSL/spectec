  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/memory.atomic.notify-oob-shared:
  s; (f; (CONST at i) (CONST I32 count) (MEMORY.ATOMIC.NOTIFY x ao); timestamp) ~>_({ 
    ACTIONS (
      RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))
    ), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  s; (f'; TRAP; timestamp')
  ---- ----
  -- otherwise
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE

rule Step/memory.atomic.notify-shared:
  s; (f; (CONST at i) (CONST I32 count) (MEMORY.ATOMIC.NOTIFY x ao); timestamp) ~>_({ 
    ACTIONS 
      (RD ord ((REGLEN a) 0) (CONST I32 $(|$mem(s; f, x).BYTES|))) 
      (RD ord ((REGDATA a) ea) (BYTES bytes)), 
    TIMEp timestamp, 
    TIME timestamp'
  })  
  s; (f'; (CONST I32 0); timestamp')
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits SHARED PAGE
  -- if $(i + ao.OFFSET + $size(I32)/8) <= |$mem((s; f), x).BYTES|


rule Step/memory.atomic.wait-oob-unshared:
  s; (f; (CONST at i) (CONST inntype expected) (CONST I64 timeout) (MEMORY.ATOMIC.WAIT inntype x ao); timestamp) ~> s; (f'; TRAP; timestamp')
  ---- ----
  -- otherwise
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE

rule Step/memory.atomic.wait-unshared:
  s; (f; (CONST at i) (CONST inntype expected) (CONST I64 timeout) (MEMORY.ATOMIC.WAIT inntype x ao); timestamp) ~> s; (f'; TRAP; timestamp')
  -- if (
          a = f.MODULE.MEMS[0] /\
          ord = SEQCST /\
          notears? = $tearing(nt, $($size(nt)/8), ao.OFFSET) /\
          storemem = $mem(s; f, x) /\
          ea = $(i + ao.OFFSET) /\
          nlen = |storemem.BYTES|
        )
  -- if $mem(s; f, x).TYPE = addrtype limits UNSHARED PAGE
  -- if $(i + ao.OFFSET + $size(inntype)/8) <= |$mem((s; f), x).BYTES|

rule Step/atomic.fence:
  s; (f; (ATOMIC.FENCE); timestamp) ~> s; (f'; eps; timestamp')

;; Reference instructions

rule Step_read/ref.null:
  s; (f; (REF.NULL ht); timestamp)  ~>  f'; REF.NULL_ADDR; timestamp'

rule Step_read/ref.func:
  s; (f; (REF.FUNC x); timestamp)  ~>  f'; (REF.FUNC_ADDR $moduleinst((s; f)).FUNCS[x]); timestamp'

rule Step_pure/ref.i31:
  f; (CONST I32 i) REF.I31; timestamp  ~>  f'; (REF.I31_NUM $wrap__(32, 31, i)); timestamp'


rule Step_pure/ref.is_null-true:
  f; ref REF.IS_NULL; timestamp  ~>  f'; (CONST I32 1); timestamp'
  -- if ref = REF.NULL_ADDR

rule Step_pure/ref.is_null-false:
  f; ref REF.IS_NULL; timestamp  ~>  f'; (CONST I32 0); timestamp'
  -- otherwise


rule Step_pure/ref.as_non_null-null:
  f; ref REF.AS_NON_NULL; timestamp  ~>  f'; TRAP; timestamp'
  -- if ref = REF.NULL_ADDR

rule Step_pure/ref.as_non_null-addr:
  f; ref REF.AS_NON_NULL; timestamp  ~>  f'; ref; timestamp'
  -- otherwise


rule Step_pure/ref.eq-null:
  f; ref_1 ref_2 REF.EQ; timestamp  ~>  f'; (CONST I32 1); timestamp'
  -- if ref_1 = REF.NULL_ADDR /\ ref_2 = REF.NULL_ADDR

rule Step_pure/ref.eq-true:
  f; ref_1 ref_2 REF.EQ; timestamp  ~>  f'; (CONST I32 1); timestamp'
  -- otherwise
  -- if ref_1 = ref_2

rule Step_pure/ref.eq-false:
  f; ref_1 ref_2 REF.EQ; timestamp  ~>  f'; (CONST I32 0); timestamp'
  -- otherwise


rule Step_read/ref.test-true:
  s; (f; ref (REF.TEST rt); timestamp)  ~>  f'; (CONST I32 1); timestamp'
  ;; TODO(3, rossberg): -- Ref_ok: s |- ref : $inst_reftype(f.MODULE, rt)
  -- Ref_ok: s |- ref : rt'
  -- Reftype_sub: {} |- rt' <: $inst_reftype(f.MODULE, rt)

rule Step_read/ref.test-false:
  s; (f; ref (REF.TEST rt); timestamp)  ~>  f'; (CONST I32 0); timestamp'
  -- otherwise


rule Step_read/ref.cast-succeed:
  s; (f; ref (REF.CAST rt); timestamp)  ~>  f'; ref; timestamp'
  ;; TODO(3, rossberg): -- Ref_ok: s |- ref : $inst_reftype(f.MODULE, rt)
  -- Ref_ok: s |- ref : rt'
  -- Reftype_sub: {} |- rt' <: $inst_reftype(f.MODULE, rt)

rule Step_read/ref.cast-fail:
  s; (f; ref (REF.CAST rt); timestamp)  ~>  f'; TRAP; timestamp'
  -- otherwise


;; Scalar reference instructions

rule Step_pure/i31.get-null:
  f; (REF.NULL_ADDR) (I31.GET sx); timestamp  ~>  f'; TRAP; timestamp'

rule Step_pure/i31.get-num:
  f; (REF.I31_NUM i) (I31.GET sx); timestamp  ~>  f'; (CONST I32 $extend__(31, 32, sx, i)); timestamp'


;; Structure instructions

rule Step/struct.new:
  s; (f; val^n (STRUCT.NEW x); timestamp)  ~>  $c_add_structinst((s; f), si); (f'; (REF.STRUCT_ADDR a); timestamp')
  -- Expand: $type((s; f), x) ~~ STRUCT (mut? zt)^n
  -- if a = |$structinst((s; f))|
  -- if si = {TYPE $type((s; f), x), FIELDS ($packfield_(zt, val))^n}

rule Step_read/struct.new_default:
  s; (f; (STRUCT.NEW_DEFAULT x); timestamp)  ~>  f'; val* (STRUCT.NEW x); timestamp'
  -- Expand: $type((s; f), x) ~~ STRUCT (mut? zt)*
  -- (if $default_($unpack(zt)) = val)*


rule Step_read/struct.get-null:
  s; (f; (REF.NULL_ADDR) (STRUCT.GET sx? x i); timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/struct.get-struct:
  s; (f; (REF.STRUCT_ADDR a) (STRUCT.GET sx? x i); timestamp)  ~>  f'; $unpackfield_(zt*[i], sx?, $structinst((s; f))[a].FIELDS[i]); timestamp'
  ----
  -- Expand: $type((s; f), x) ~~ STRUCT (mut? zt)*


rule Step/struct.set-null:
  s; (f; (REF.NULL_ADDR) val (STRUCT.SET x i); timestamp)  ~>  s; (f'; TRAP; timestamp')

rule Step/struct.set-struct:
  s; (f; (REF.STRUCT_ADDR a) val (STRUCT.SET x i); timestamp)  ~>  $c_with_struct((s; f), a, i, $packfield_(zt*[i], val)); (f'; eps; timestamp')
  ----
  -- Expand: $type((s; f), x) ~~ STRUCT (mut? zt)*


;; Array instructions

rule Step_pure/array.new:
  f; val (CONST I32 n) (ARRAY.NEW x); timestamp  ~>  f'; val^n (ARRAY.NEW_FIXED x n); timestamp'

rule Step_read/array.new_default:
  s; (f; (CONST I32 n) (ARRAY.NEW_DEFAULT x); timestamp)  ~>  f'; val^n (ARRAY.NEW_FIXED x n); timestamp'
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)
  -- if $default_($unpack(zt)) = val

rule Step/array.new_fixed:
  s; (f; val^n (ARRAY.NEW_FIXED x n); timestamp)  ~>  $c_add_arrayinst((s; f), ai); (f'; (REF.ARRAY_ADDR a); timestamp')
  ----
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)
  -- if a = |$arrayinst((s; f))|
     /\ ai = {TYPE $type((s; f), x), FIELDS ($packfield_(zt, val))^n}


rule Step_read/array.new_elem-oob:
  s; (f; (CONST I32 i) (CONST I32 n) (ARRAY.NEW_ELEM x y); timestamp)  ~>  f'; TRAP; timestamp'
  -- if $(i + n > |$elem((s; f), y).REFS|)

rule Step_read/array.new_elem-alloc:
  s; (f; (CONST I32 i) (CONST I32 n) (ARRAY.NEW_ELEM x y); timestamp)  ~>  f'; ref^n (ARRAY.NEW_FIXED x n); timestamp'
  ----
  -- if ref^n = $elem((s; f), y).REFS[i : n]


rule Step_read/array.new_data-oob:
  s; (f; (CONST I32 i) (CONST I32 n) (ARRAY.NEW_DATA x y); timestamp)  ~>  f'; TRAP; timestamp'
  ----
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)
  -- if $(i + n * $zsize(zt)/8 > |$data((s; f), y).BYTES|)

;; TODO(2, rossberg): outline Cnn = $cunpack(zt)
rule Step_read/array.new_data-num:
  s; (f; (CONST I32 i) (CONST I32 n) (ARRAY.NEW_DATA x y); timestamp)  ~>  f'; ($const($cunpack(zt), $cunpacknum_(zt, c)))^n (ARRAY.NEW_FIXED x n); timestamp'
  ----
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)
  -- if $concatn_(byte, $zbytes_(zt, c)^n, $($zsize(zt)/8)) = $data((s; f), y).BYTES[i : n * $zsize(zt)/8]


rule Step_read/array.get-null:
  s; (f; (REF.NULL_ADDR) (CONST I32 i) (ARRAY.GET sx? x); timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/array.get-oob:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (ARRAY.GET sx? x); timestamp)  ~>  f'; TRAP; timestamp'
  -- if i >= |$arrayinst((s; f))[a].FIELDS|

rule Step_read/array.get-array:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (ARRAY.GET sx? x); timestamp)  ~>  f'; $unpackfield_(zt, sx?, $arrayinst((s; f))[a].FIELDS[i]); timestamp'
  ----
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)


rule Step/array.set-null:
  s; (f; (REF.NULL_ADDR) (CONST I32 i) val (ARRAY.SET x); timestamp)  ~>  s; (f'; TRAP; timestamp')

rule Step/array.set-oob:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) val (ARRAY.SET x); timestamp)  ~>  s; (f'; TRAP; timestamp')
  -- if i >= |$arrayinst((s; f))[a].FIELDS|

rule Step/array.set-array:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) val (ARRAY.SET x); timestamp)  ~>  $c_with_array((s; f), a, i, $packfield_(zt, val)); (f'; eps; timestamp')
  ----
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)


rule Step_read/array.len-null:
  s; (f; (REF.NULL_ADDR) ARRAY.LEN; timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/array.len-array:
  s; (f; (REF.ARRAY_ADDR a) ARRAY.LEN; timestamp)  ~>  f'; (CONST I32 $(|$arrayinst((s; f))[a].FIELDS|)); timestamp'


rule Step_read/array.fill-null:
  s; (f; (REF.NULL_ADDR) (CONST I32 i) val (CONST I32 n) (ARRAY.FILL x); timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/array.fill-oob:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) val (CONST I32 n) (ARRAY.FILL x); timestamp)  ~>  f'; TRAP; timestamp'
  -- if $(i + n > |$arrayinst((s; f))[a].FIELDS|)

rule Step_read/array.fill-zero:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) val (CONST I32 n) (ARRAY.FILL x); timestamp)  ~>  f'; eps; timestamp'
  -- otherwise
  -- if n = 0

rule Step_read/array.fill-succ:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) val (CONST I32 n) (ARRAY.FILL x); timestamp)  ~>
    f; 
    (REF.ARRAY_ADDR a) (CONST I32 i) val (ARRAY.SET x)
    (REF.ARRAY_ADDR a) (CONST I32 $(i + 1)) val (CONST I32 $(n-1)) (ARRAY.FILL x);
    timestamp
  -- otherwise

rule Step_read/array.copy-null1:
  s; (f; (REF.NULL_ADDR) (CONST I32 i_1) ref (CONST I32 i_2) (CONST I32 n) (ARRAY.COPY x_1 x_2); timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/array.copy-null2:
  s; (f; ref (CONST I32 i_1) (REF.NULL_ADDR) (CONST I32 i_2) (CONST I32 n) (ARRAY.COPY x_1 x_2); timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/array.copy-oob1:
  s; (f; (REF.ARRAY_ADDR a_1) (CONST I32 i_1) (REF.ARRAY_ADDR a_2) (CONST I32 i_2) (CONST I32 n) (ARRAY.COPY x_1 x_2); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- if $(i_1 + n > |$arrayinst((s; f))[a_1].FIELDS|)

rule Step_read/array.copy-oob2:
  s; (f; (REF.ARRAY_ADDR a_1) (CONST I32 i_1) (REF.ARRAY_ADDR a_2) (CONST I32 i_2) (CONST I32 n) (ARRAY.COPY x_1 x_2); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- if $(i_2 + n > |$arrayinst((s; f))[a_2].FIELDS|)

rule Step_read/array.copy-zero:
  s; (f; (REF.ARRAY_ADDR a_1) (CONST I32 i_1) (REF.ARRAY_ADDR a_2) (CONST I32 i_2) (CONST I32 n) (ARRAY.COPY x_1 x_2); timestamp)  ~>  f'; eps; timestamp'
  ---- ----
  -- otherwise
  -- if n = 0

rule Step_read/array.copy-le:
  s; (f; (REF.ARRAY_ADDR a_1) (CONST I32 i_1) (REF.ARRAY_ADDR a_2) (CONST I32 i_2) (CONST I32 n) (ARRAY.COPY x_1 x_2); timestamp)  ~>
    f; 
    (REF.ARRAY_ADDR a_1) (CONST I32 i_1)
    (REF.ARRAY_ADDR a_2) (CONST I32 i_2)
    (ARRAY.GET sx? x_2) (ARRAY.SET x_1)
    (REF.ARRAY_ADDR a_1) (CONST I32 $(i_1 + 1)) (REF.ARRAY_ADDR a_2) (CONST I32 $(i_2 + 1)) (CONST I32 $(n-1)) (ARRAY.COPY x_1 x_2);
    timestamp
  ---- ----
  -- otherwise
  -- Expand: $type((s; f), x_2) ~~ ARRAY (mut? zt_2)
  -- if i_1 <= i_2
     /\ sx? = $sx(zt_2)

rule Step_read/array.copy-gt:
  s; (f; (REF.ARRAY_ADDR a_1) (CONST I32 i_1) (REF.ARRAY_ADDR a_2) (CONST I32 i_2) (CONST I32 n) (ARRAY.COPY x_1 x_2); timestamp)  ~>
    f;
    (REF.ARRAY_ADDR a_1) (CONST I32 $(i_1 + n - 1))
    (REF.ARRAY_ADDR a_2) (CONST I32 $(i_2 + n - 1))
    (ARRAY.GET sx? x_2) (ARRAY.SET x_1)
    (REF.ARRAY_ADDR a_1) (CONST I32 i_1) (REF.ARRAY_ADDR a_2) (CONST I32 i_2) (CONST I32 $(n-1)) (ARRAY.COPY x_1 x_2);
    timestamp
  ---- ----
  -- otherwise
  -- Expand: $type((s; f), x_2) ~~ ARRAY (mut? zt_2)
  -- if sx? = $sx(zt_2)


rule Step_read/array.init_elem-null:
  s; (f; (REF.NULL_ADDR) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_ELEM x y); timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/array.init_elem-oob1:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_ELEM x y); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- if $(i + n > |$arrayinst((s; f))[a].FIELDS|)

rule Step_read/array.init_elem-oob2:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_ELEM x y); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- if $(j + n > |$elem((s; f), y).REFS|)

rule Step_read/array.init_elem-zero:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_ELEM x y); timestamp)  ~>  f'; eps; timestamp'
  ---- ----
  -- otherwise
  -- if n = 0

rule Step_read/array.init_elem-succ:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_ELEM x y); timestamp)  ~>
    f;
    (REF.ARRAY_ADDR a) (CONST I32 i) ref (ARRAY.SET x)
    (REF.ARRAY_ADDR a) (CONST I32 $(i + 1)) (CONST I32 $(j + 1)) (CONST I32 $(n-1)) (ARRAY.INIT_ELEM x y);
    timestamp
  ---- ----
  -- otherwise
  -- if ref = $elem((s; f), y).REFS[j]


rule Step_read/array.init_data-null:
  s; (f; (REF.NULL_ADDR) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_DATA x y); timestamp)  ~>  f'; TRAP; timestamp'

rule Step_read/array.init_data-oob1:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_DATA x y); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- if $(i + n > |$arrayinst((s; f))[a].FIELDS|)

rule Step_read/array.init_data-oob2:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_DATA x y); timestamp)  ~>  f'; TRAP; timestamp'
  ---- ----
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)
  -- if $(j + n * $zsize(zt)/8 > |$data((s; f), y).BYTES|)

rule Step_read/array.init_data-zero:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_DATA x y); timestamp)  ~>  f'; eps; timestamp'
  ---- ----
  -- otherwise
  -- if n = 0

;; TODO(2, rossberg): outline Cnn = $cunpack(zt)
rule Step_read/array.init_data-num:
  s; (f; (REF.ARRAY_ADDR a) (CONST I32 i) (CONST I32 j) (CONST I32 n) (ARRAY.INIT_DATA x y); timestamp)  ~>
    f; 
    (REF.ARRAY_ADDR a) (CONST I32 i) ($const($cunpack(zt), $cunpacknum_(zt, c))) (ARRAY.SET x)
    (REF.ARRAY_ADDR a) (CONST I32 $(i + 1)) (CONST I32 $(j + $zsize(zt)/8)) (CONST I32 $(n-1)) (ARRAY.INIT_DATA x y);
    timestamp
  ---- ----
  -- otherwise
  -- Expand: $type((s; f), x) ~~ ARRAY (mut? zt)
  -- if $zbytes_(zt, c) = $data((s; f), y).BYTES[j : $zsize(zt)/8]


;; External reference instructions

rule Step_pure/extern.convert_any-null:
  f; ref EXTERN.CONVERT_ANY; timestamp  ~>  f'; REF.NULL_ADDR; timestamp'
  -- if ref = REF.NULL_ADDR

rule Step_pure/extern.convert_any-addr:
f; ref EXTERN.CONVERT_ANY; timestamp  ~>  f'; (REF.EXTERN ref); timestamp'
  -- otherwise


rule Step_pure/any.convert_extern-null:
  f; (REF.NULL_ADDR) ANY.CONVERT_EXTERN; timestamp  ~>  f'; REF.NULL_ADDR; timestamp'

rule Step_pure/any.convert_extern-addr:
  f; (REF.EXTERN ref) ANY.CONVERT_EXTERN; timestamp  ~>  f'; ref; timestamp'


;; Numeric instructions

rule Step_pure/unop-val:
  f; (CONST nt c_1) (UNOP nt unop); timestamp  ~>  f'; (CONST nt c); timestamp'
  -- if c <- $unop_(nt, unop, c_1)

rule Step_pure/unop-trap:
  f; (CONST nt c_1) (UNOP nt unop); timestamp  ~>  f'; TRAP; timestamp'
  -- if $unop_(nt, unop, c_1) = eps


rule Step_pure/binop-val:
  f; (CONST nt c_1) (CONST nt c_2) (BINOP nt binop); timestamp  ~>  f'; (CONST nt c); timestamp'
  -- if c <- $binop_(nt, binop, c_1, c_2)

rule Step_pure/binop-trap:
  f; (CONST nt c_1) (CONST nt c_2) (BINOP nt binop); timestamp  ~>  f'; TRAP; timestamp'
  -- if $binop_(nt, binop, c_1, c_2) = eps


rule Step_pure/testop:
  f; (CONST nt c_1) (TESTOP nt testop); timestamp  ~>  f'; (CONST I32 c); timestamp'
  -- if c = $testop_(nt, testop, c_1)

rule Step_pure/relop:
  f; (CONST nt c_1) (CONST nt c_2) (RELOP nt relop); timestamp  ~>  f'; (CONST I32 c); timestamp'
  -- if c = $relop_(nt, relop, c_1, c_2)


rule Step_pure/cvtop-val:
  f; (CONST nt_1 c_1) (CVTOP nt_2 nt_1 cvtop); timestamp  ~>  f'; (CONST nt_2 c); timestamp'
  -- if c <- $cvtop__(nt_1, nt_2, cvtop, c_1)

rule Step_pure/cvtop-trap:
  f; (CONST nt_1 c_1) (CVTOP nt_2 nt_1 cvtop); timestamp  ~>  f'; TRAP; timestamp'
  -- if $cvtop__(nt_1, nt_2, cvtop, c_1) = eps


;; Vector instructions

rule Step_pure/vvunop:
  f; (VCONST V128 c_1) (VVUNOP V128 vvunop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c <- $vvunop_(V128, vvunop, c_1)


rule Step_pure/vvbinop:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VVBINOP V128 vvbinop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c <- $vvbinop_(V128, vvbinop, c_1, c_2)


rule Step_pure/vvternop:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VCONST V128 c_3) (VVTERNOP V128 vvternop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  ----
  -- if c <- $vvternop_(V128, vvternop, c_1, c_2, c_3)


rule Step_pure/vvtestop:
  f; (VCONST V128 c_1) (VVTESTOP V128 ANY_TRUE); timestamp ~> f'; (CONST I32 c); timestamp'
  -- if c = $inez_($vsize(V128), c_1)


rule Step_pure/vunop-val:
  f; (VCONST V128 c_1) (VUNOP sh vunop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c <- $vunop_(sh, vunop, c_1)

rule Step_pure/vunop-trap:
  f; (VCONST V128 c_1) (VUNOP sh vunop); timestamp  ~>  f'; TRAP; timestamp'
  -- if $vunop_(sh, vunop, c_1) = eps


rule Step_pure/vbinop-val:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VBINOP sh vbinop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c <- $vbinop_(sh, vbinop, c_1, c_2)

rule Step_pure/vbinop-trap:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VBINOP sh vbinop); timestamp  ~>  f'; TRAP; timestamp'
  -- if $vbinop_(sh, vbinop, c_1, c_2) = eps


rule Step_pure/vternop-val:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VCONST V128 c_3) (VTERNOP sh vternop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c <- $vternop_(sh, vternop, c_1, c_2, c_3)

rule Step_pure/vternop-trap:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VCONST V128 c_3) (VTERNOP sh vternop); timestamp  ~>  f'; TRAP; timestamp'
  -- if $vternop_(sh, vternop, c_1, c_2, c_3) = eps


rule Step_pure/vtestop:
  f; (VCONST V128 c_1) (VTESTOP (Jnn X M) ALL_TRUE); timestamp ~> f'; (CONST I32 c); timestamp'
  -- if i* = $lanes_(Jnn X M, c_1)
  -- if c = $prod(($inez_($jsizenn(Jnn), i)*))


rule Step_pure/vrelop:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VRELOP sh vrelop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c = $vrelop_(sh, vrelop, c_1, c_2)


rule Step_pure/vshiftop:
  f; (VCONST V128 c_1) (CONST I32 i) (VSHIFTOP sh vshiftop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c = $vshiftop_(sh, vshiftop, c_1, i)


rule Step_pure/vbitmask:
  f; (VCONST V128 c_1) (VBITMASK sh); timestamp  ~>  f'; (CONST I32 c); timestamp'
  -- if c = $vbitmaskop_(sh, c_1)


rule Step_pure/vswizzlop:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VSWIZZLOP sh swizzlop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c = $vswizzlop_(sh, swizzlop, c_1, c_2)


rule Step_pure/vshuffle:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VSHUFFLE sh i*); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c = $vshufflop_(sh, i*, c_1, c_2)


rule Step_pure/vsplat:
  f; (CONST $lunpack(Lnn) c_1) (VSPLAT (Lnn X M)); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c = $inv_lanes_(Lnn X M, $lpacknum_(Lnn, c_1)^M)


rule Step_pure/vextract_lane-num:
  f; (VCONST V128 c_1) (VEXTRACT_LANE (nt X M) i); timestamp  ~>  f'; (CONST nt c_2); timestamp'
  -- if c_2 = $lanes_(nt X M, c_1)[i]

rule Step_pure/vextract_lane-pack:
  f; (VCONST V128 c_1) (VEXTRACT_LANE (pt X M) sx i); timestamp  ~>  f'; (CONST I32 c_2); timestamp'
  -- if c_2 = $extend__($psize(pt), 32, sx, $lanes_(pt X M, c_1)[i])


rule Step_pure/vreplace_lane:
  f; (VCONST V128 c_1) (CONST $lunpack(Lnn) c_2) (VREPLACE_LANE (Lnn X M) i); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  ---- ----
  -- if c = $inv_lanes_(Lnn X M, $lanes_(Lnn X M, c_1)[[i] = $lpacknum_(Lnn, c_2)])


rule Step_pure/vextunop:
  f; (VCONST V128 c_1) (VEXTUNOP sh_2 sh_1 vextunop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if $vextunop__(sh_1, sh_2, vextunop, c_1) = c


rule Step_pure/vextbinop:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VEXTBINOP sh_2 sh_1 vextbinop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if $vextbinop__(sh_1, sh_2, vextbinop, c_1, c_2) = c


rule Step_pure/vextternop:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VCONST V128 c_3) (VEXTTERNOP sh_2 sh_1 vextternop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  ----
  -- if $vextternop__(sh_1, sh_2, vextternop, c_1, c_2, c_3) = c


rule Step_pure/vnarrow:
  f; (VCONST V128 c_1) (VCONST V128 c_2) (VNARROW sh_2 sh_1 sx); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c = $vnarrowop__(sh_1, sh_2, sx, c_1, c_2)


rule Step_pure/vcvtop:
  f; (VCONST V128 c_1) (VCVTOP sh_2 sh_1 vcvtop); timestamp  ~>  f'; (VCONST V128 c); timestamp'
  -- if c = $vcvtop__(sh_1, sh_2, vcvtop, c_1)

;; Expressions

relation Eval_expr: state; expr ~>* state; val*  hint(name "E-expr") hint(macro "steptostar") hint(tabular)

(;
rule Eval_expr:
  s; f; instr*  ~>*  s'; f'; val*
  -- Steps: s; f; instr*; timestamp  ~>*  s'; f'; val*; timestamp'
;)