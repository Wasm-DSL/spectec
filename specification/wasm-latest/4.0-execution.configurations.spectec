def $sameandtearfreefilter(region, event, event*): event*
def $sameandtearfreefilter(reg, evt1, eps) = eps
def $sameandtearfreefilter(reg, evt1, evt' evt*) = evt' $sameandtearfreefilter(reg, evt1, evt*) -- if $same($access_r(reg, evt1), $access_r(reg, evt')) /\ $tearfree($access_r(reg, evt'))

def $suspfilter(region, u32, event*) : event*
def $suspfilter(reg, u32, eps) = eps
def $suspfilter(reg, u32, evt' evt*) = evt' $suspfilter(reg, u32, evt*) 
-- if $susp(u32, $access_r(reg, evt')) =/= eps

def $tearing(numtype, nat, u64): notears?